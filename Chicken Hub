--[[
	Notify(opts)
	  opts.Title   : string
	  opts.Message : string
	  opts.Type    : "info" | "success" | "warn" | "error"  (default "info")
	  opts.Duration: number seconds before auto-dismiss      (default 5)

	WatchRemote(remote, displayName, interval)
	  Runs a periodic pcall on the remote.  On failure (remote gone or errors)
	  calls Notify with Type = "error".  interval defaults to 30 s.
]]

