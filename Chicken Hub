	function sec:AddSlider(o)
		local min,max = o.Min or 0, o.Max or 100
		local step    = o.Step or 1
		local r = row(250, o.Name, o.Description)
		local box = lib:_bind(new("TextBox",{
			Text=tostring(o.Default or min), Font=FONT_B, TextSize=13,
			TextColor3=TEXT, ClearTextOnFocus=false,
			Size=UDim2.fromOffset(56,30), AnchorPoint=Vector2.new(1,0.5),
			Position=UDim2.new(1,-12,0.5,0), ZIndex=2, Parent=r,
		},{corner(7)}), "BackgroundColor3","Bg")
		lib:_bind(new("UIStroke",{Transparency=0.2,ApplyStrokeMode=Enum.ApplyStrokeMode.Border,Parent=box}),
			"Color","Accent")
		gloss(box,0.8)
		local bar = new("Frame",{
			Size=UDim2.fromOffset(150,6), AnchorPoint=Vector2.new(1,0.5),
			Position=UDim2.new(1,-82,0.5,0),
			BackgroundColor3=Color3.fromRGB(8,8,10), ZIndex=2, Parent=r,
		},{corner(3)})
		local hitbox = new("TextButton",{
			Text="",BackgroundTransparency=1,
			Size=UDim2.new(1,16,0,26),Position=UDim2.new(0,-8,0.5,-13),ZIndex=5,Parent=bar,
		})
		local fill = lib:_bind(new("Frame",{Size=UDim2.fromScale(0,1),ZIndex=3,Parent=bar},{corner(3)}),
			"BackgroundColor3","Accent")
		new("UIGradient",{Rotation=90,Color=ColorSequence.new(Color3.new(1,1,1),Color3.fromRGB(170,170,170)),Parent=fill})
		local knob = new("Frame",{
			Size=UDim2.fromOffset(16,16), AnchorPoint=Vector2.new(0.5,0.5),
			Position=UDim2.fromScale(0,0.5), BackgroundColor3=Color3.new(1,1,1), ZIndex=4, Parent=bar,
		},{corner(8)})
		new("UIGradient",{Rotation=90,Color=ColorSequence.new(Color3.new(1,1,1),Color3.fromRGB(195,195,195)),Parent=knob})
		lib:_bind(new("UIStroke",{Thickness=3,Transparency=0.55,Parent=knob}),"Color","Accent")
		local api,value = {},nil
		function api:Set(v,silent)
			v = tonumber(v) or value or min
			v = math.clamp(math.floor((v-min)/step+0.5)*step+min,min,max)
			local a = (max>min) and (v-min)/(max-min) or 0
			fill.Size=UDim2.fromScale(a,1); knob.Position=UDim2.fromScale(a,0.5); box.Text=tostring(v)
			if v==value then return end
			value=v
			if o.Callback and not silent then task.spawn(o.Callback,v) end
		end
		function api:Get() return value end
		local dragging=false
		local function update(x)
			api:Set(min+(max-min)*math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1))
		end
		hitbox.InputBegan:Connect(function(i)
			if i.UserInputType==Enum.UserInputType.MouseButton1
			or i.UserInputType==Enum.UserInputType.Touch then
				dragging=true; update(i.Position.X)
				tween(knob,0.15,{Size=UDim2.fromOffset(20,20)})
			end
		end)
		lib:_conn(UserInputService.InputChanged:Connect(function(i)
			if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement
			or i.UserInputType==Enum.UserInputType.Touch) then update(i.Position.X) end
		end))
		lib:_conn(UserInputService.InputEnded:Connect(function(i)
			if dragging and (i.UserInputType==Enum.UserInputType.MouseButton1
			or i.UserInputType==Enum.UserInputType.Touch) then
				dragging=false; tween(knob,0.15,{Size=UDim2.fromOffset(16,16)})
			end
		end))
		box.FocusLost:Connect(function() api:Set(box.Text) end)
		api:Set(o.Default or min,true)
		lib:_regCfg(o.Key,api)
		return api
	end

