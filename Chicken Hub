-- Notification log refresh  (internal)
-- ─────────────────────────────────────────────────────────────────────────────

function Library:_refreshNotifLog()
	local list = self._notifLog
	if not list or not list.Parent then return end

	-- Remove old entries only (keep UIListLayout / UIPadding)
	for _, c in ipairs(list:GetChildren()) do
		if c.Name == "NotifEntry" or c.Name == "NotifEmpty" then
			c:Destroy()
		end
	end

	if #self._notifications == 0 then
		new("TextLabel", {
			Name = "NotifEmpty",
			Text = "No notifications yet.", Font = FONT, TextSize = 12,
			TextColor3 = SUBTEXT, BackgroundTransparency = 1,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.new(1,-16,0,32), Parent = list,
		})
		return
	end

	for _, t in ipairs(self._notifications) do
		local color = NOTIF_COLORS[t.Type] or self.Theme.Accent
		local entry = self:_bind(new("Frame", {
			Name = "NotifEntry",
			Size = UDim2.new(1,-8,0,56),
			BackgroundTransparency = 0.2,
			ClipsDescendants = true,
			Parent = list,
		}, {corner(10)}), "BackgroundColor3","Item")
		-- Left type stripe
		new("Frame", {
			BackgroundColor3 = color, BorderSizePixel = 0,
			Size = UDim2.new(0,3,1,-12), Position = UDim2.fromOffset(5,6),
			Parent = entry,
		}, {corner(2)})
		-- Type dot
		new("Frame", {
			BackgroundColor3 = color, BorderSizePixel = 0,
			Size = UDim2.fromOffset(7,7), Position = UDim2.fromOffset(14,8),
			Parent = entry,
		}, {corner(4)})
		-- Title
		new("TextLabel", {
			Text = t.Title, Font = FONT_B, TextSize = 12, TextColor3 = TEXT,
			BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Size = UDim2.fromOffset(190,16), Position = UDim2.fromOffset(26,6),
			Parent = entry,
		})
		-- Time
		new("TextLabel", {
			Text = t.TimeStr, Font = FONT, TextSize = 10, TextColor3 = SUBTEXT,
			BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Right,
			Size = UDim2.fromOffset(60,14), Position = UDim2.fromOffset(214,8),
			Parent = entry,
		})
		-- Message
		new("TextLabel", {
			Text = t.Message, Font = FONT, TextSize = 11, TextColor3 = SUBTEXT,
			BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true, TextTruncate = Enum.TextTruncate.AtEnd,
			Size = UDim2.new(1,-30,0,20), Position = UDim2.fromOffset(14,30),
			Parent = entry,
		})
		-- Border tinted to type
		new("UIStroke", {
			Color = color, Transparency = 0.7,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = entry,
		})
	end
end

-- ─────────────────────────────────────────────────────────────────────────────
-- AddDashboardTab
-- ─────────────────────────────────────────────────────────────────────────────

--[[
	AddDashboardTab(opts)
	  opts.Name  : tab label (default "Dashboard")
	  opts.Icon  : icon key  (default "grid")

	Returns the tab.  Also exposes tab.StatusText (AddText api) so you can
	update the connection status from outside:
	    local dash = Lib:AddDashboardTab()
	    dash.StatusText:Set("● Connected")
]]

function Library:AddDashboardTab(opts)
	opts = opts or {}
	local tab = self:AddTab(opts.Name or "Dashboard", opts.Icon or "grid")

	-- ── Player ────────────────────────────────────────────────────────────────
	local plrSec = tab:AddSection("Player")
	plrSec:AddText("User: " .. player.Name)
	if player.DisplayName ~= player.Name then
		plrSec:AddText("Display: " .. player.DisplayName)
	end
	plrSec:AddText("ID: " .. player.UserId)
	plrSec:AddText("Account age: " .. player.AccountAge .. " day"
		.. (player.AccountAge == 1 and "" or "s"))

	-- ── Game ──────────────────────────────────────────────────────────────────
	local gameSec = tab:AddSection("Game")
	local gameName = gameSec:AddText("Game: fetching…")
	gameSec:AddText("Place ID: " .. game.PlaceId)
	local jobShort = game.JobId:sub(1,16) .. "…"
	gameSec:AddText("Job ID: " .. jobShort)
	local serverCount = gameSec:AddText("Players: " .. #Players:GetPlayers() .. " in server")

	-- Async fetch game name (MarketplaceService can yield)
	task.spawn(function()
		local ok, info = pcall(MarketplaceService.GetProductInfo,
			MarketplaceService, game.PlaceId)
		if ok and info and info.Name then
			gameName:Set("Game: " .. info.Name)
		else
			gameName:Set("Game: (unavailable)")
		end
	end)

	-- Keep player count live
	local function updateCount()
		if serverCount then
			serverCount:Set("Players: " .. #Players:GetPlayers() .. " in server")
		end
	end
	Players.PlayerAdded:Connect(updateCount)
	Players.PlayerRemoving:Connect(updateCount)

	-- ── Hub ───────────────────────────────────────────────────────────────────
	local hubSec = tab:AddSection("Hub")
	hubSec:AddText("Version: " .. (self._version or "—"))
	local themeDisplay = hubSec:AddText("Theme: " .. self.ThemeName)
	table.insert(self._onTheme, function()
		themeDisplay:Set("Theme: " .. self.ThemeName)
	end)
	if self._configFile then
		hubSec:AddText("Config: " .. self._configFile)
	end

	-- ── Connection / status ───────────────────────────────────────────────────
	local connSec = tab:AddSection("Connection")
	local statusApi = connSec:AddText("● Connected")
	tab.StatusText = statusApi           -- expose for caller

	-- Detect disconnection
	local wasAlive = true
	task.spawn(function()
		while true do
			task.wait(5)
			local alive = RunService.Heartbeat ~= nil
			if not alive and wasAlive then
				wasAlive = false
				statusApi:Set("○ Disconnected")
				self:Notify({
					Title   = "Connection Lost",
					Message = "The game connection appears to be down.",
					Type    = "error",
					Duration = 10,
				})
			end
		end
	end)

	connSec:AddButton({
		Name = "Test Remotes",
		ButtonText = "▶  Test",
		Callback = function()
			self:Notify({
				Title   = "Remote Test",
				Message = "Use Lib:WatchRemote(remote, name) to monitor specific remotes.",
				Type    = "info",
				Duration = 6,
			})
		end,
	})

	return tab
end

-- ─────────────────────────────────────────────────────────────────────────────
-- AddNotificationsTab
-- ─────────────────────────────────────────────────────────────────────────────

--[[
	AddNotificationsTab(opts)
	  opts.Name  : tab label (default "Notifications")
	  opts.Icon  : icon key  (default "dot")

	All calls to Lib:Notify() automatically update this tab's log.
]]

function Library:AddNotificationsTab(opts)
	opts = opts or {}
	local tab = self:AddTab(opts.Name or "Notifications", opts.Icon or "dot")

	-- ── Controls ─────────────────────────────────────────────────────────────
	local ctrlSec = tab:AddSection("Controls")

	ctrlSec:AddToggle({
		Name    = "Show toasts",
		Key     = "_notif_toasts",
		Default = true,
		Callback = function(v)
			self._toastsEnabled = v
		end,
	})

	ctrlSec:AddButton({
		Name       = "Clear all",
		ButtonText = "✕  Clear",
		Callback   = function()
			self._notifications = {}
			self:_refreshNotifLog()
			self:Notify({
				Title   = "Log cleared",
				Message = "All notifications have been removed.",
				Type    = "info",
				Duration = 3,
			})
		end,
	})

	-- ── Log section ──────────────────────────────────────────────────────────
	local logSec = tab:AddSection("Log")
	logSec:SetOpen(true)

	-- Store a reference to the section's internal list frame
	self._notifLog = logSec._listFrame

	-- Initial populate
	self:_refreshNotifLog()

	return tab
end

return Library
