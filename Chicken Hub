	local itemSeq = 0
	local function nextOrder() itemSeq += 1; return itemSeq end

	-- AbsoluteSize includes the window's UIScale, so divide it back out.
	local open = true
	local function resize(animate)
		local scale = lib._scale and lib._scale.Scale or 1
		if scale <= 0 then scale = 1 end
		local h = open and (46 + math.ceil(list.AbsoluteSize.Y / scale)) or 44
		if animate then tween(frame, 0.25, { Size = UDim2.new(1, 0, 0, h) })
		else frame.Size = UDim2.new(1, 0, 0, h) end
		tween(arrow, 0.25, { Rotation = open and 90 or 0 })
	end
	list:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() if open then resize(false) end end)
	header.MouseButton1Click:Connect(function() open = not open; resize(true) end)
	function sec:SetOpen(v) open = v and true or false; resize(false) end

	local function row(rightWidth, itemName, desc, withHit)
		rightWidth = rightWidth or 70
		local r = lib:_bind(new("Frame", {
			Size = UDim2.new(1, 0, 0, desc and 52 or 42), BackgroundTransparency = 0.25,
			LayoutOrder = nextOrder(), Parent = list,
		}, { corner(10) }), "BackgroundColor3", "Item")
		gloss(r, 1.1)
		local playSweep = sweep(r)
		local st = lib:_bind(new("UIStroke", { Transparency = 0.6, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = r }), "Color", "Stroke")
		local hit
		if withHit then
			hit = new("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = r })
		end
		local hoverSrc = hit or r
		hoverSrc.MouseEnter:Connect(function()
			tween(r, 0.18, { BackgroundTransparency = 0.05 })
			tween(st, 0.18, { Color = lib.Theme.Accent, Transparency = 0.35 })
			playSweep()
		end)
		hoverSrc.MouseLeave:Connect(function()
			tween(r, 0.18, { BackgroundTransparency = 0.25 })
			tween(st, 0.18, { Color = lib.Theme.Stroke, Transparency = 0.6 })
		end)
		if itemName then
			new("TextLabel", {
				Text = itemName, Font = FONT_B, TextSize = 13, TextColor3 = TEXT,
				BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
				Size = UDim2.new(1, -(rightWidth + 24), 0, 18), Position = UDim2.new(0, 12, 0, desc and 8 or 12), Parent = r,
			})
			if desc then
				new("TextLabel", {
					Text = desc, Font = FONT, TextSize = 11, TextColor3 = SUBTEXT,
					BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
					Size = UDim2.new(1, -(rightWidth + 24), 0, 14), Position = UDim2.fromOffset(12, 28), Parent = r,
				})
			end
			table.insert(tab._items, { Name = itemName, Frame = r })
		end
		return r, hit
	end

