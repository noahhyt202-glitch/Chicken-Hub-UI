	end

	function sec:AddDropdown(o)
		local items, current = {}, o.Default
		local r = row(150, o.Name, o.Description)
		local baseH = r.Size.Y.Offset
		local dpBtn = lib:_bind(new("TextButton", {
			Text = tostring(current or "Select…") .. "  ▾", Font = FONT_B, TextSize = 12, TextColor3 = TEXT,
			AutoButtonColor = false, TextTruncate = Enum.TextTruncate.AtEnd,
			Size = UDim2.fromOffset(140, 28), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, (baseH - 28) / 2),
			ZIndex = 6, Parent = r,
		}, { corner(7) }), "BackgroundColor3", "Bg")
		lib:_bind(new("UIStroke", { Transparency = 0.4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = dpBtn }), "Color", "Accent")
		gloss(dpBtn, 0.8)
		local menu = lib:_bind(new("ScrollingFrame", {
			Visible = false, Size = UDim2.new(1, -20, 0, 0), Position = UDim2.fromOffset(10, baseH),
			BorderSizePixel = 0, ScrollBarThickness = 2, AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(), ZIndex = 20, Parent = r,
		}, { corner(8), new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
			 new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }) }),
			"BackgroundColor3", "Panel")
		lib:_bind(new("UIStroke", { Transparency = 0.3, Parent = menu }), "Color", "Stroke")
		local api = {}
		local function menuH() return math.min(#items, 5) * 28 + 8 end
		local function setOpen(v)
			v = v and #items > 0
			menu.Visible = v
			menu.Size = UDim2.new(1, -20, 0, menuH())
			tween(r, 0.2, { Size = UDim2.new(1, 0, 0, v and (baseH + menuH() + 8) or baseH) })
		end
		function api:Set(v, silent)
			current = v
			dpBtn.Text = tostring(v == nil and "Select…" or v) .. "  ▾"
			setOpen(false)
			if o.Callback and not silent then task.spawn(o.Callback, v) end
		end
		function api:Get() return current end
		api._fire = function() if o.Callback and current ~= nil then task.spawn(o.Callback, current) end end
		function api:Refresh(newItems)
			items = table.clone(newItems or {})
			for _, c in ipairs(menu:GetChildren()) do
				if c:IsA("TextButton") then c:Destroy() end
			end
			for i, it in ipairs(items) do
				local ob = lib:_bind(new("TextButton", {
					Text = tostring(it), Font = FONT, TextSize = 12, TextColor3 = TEXT, AutoButtonColor = false,
					BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = i, ZIndex = 21, Parent = menu,
				}, { corner(6) }), "BackgroundColor3", "Accent")
				ob.MouseEnter:Connect(function() tween(ob, 0.1, { BackgroundTransparency = 0.5 }) end)
				ob.MouseLeave:Connect(function() tween(ob, 0.1, { BackgroundTransparency = 1 }) end)
				ob.MouseButton1Click:Connect(function() api:Set(it) end)
			end
			if menu.Visible then setOpen(true) end
		end
		dpBtn.MouseButton1Click:Connect(function() setOpen(not menu.Visible) end)
		api:Refresh(o.Options)
		lib:_regCfg(o.Key, api)
		return api
	end

	function sec:AddTextInput(o)
		local items = o.Options or {}
		local r = row(170, o.Name, o.Description)
		local baseH = r.Size.Y.Offset
		local suppress = false
		local box = lib:_bind(new("TextBox", {
			PlaceholderText = o.Placeholder or "type…", Text = tostring(o.Default or ""),
			Font = FONT, TextSize = 13, TextColor3 = TEXT, PlaceholderColor3 = SUBTEXT,
			TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, TextTruncate = Enum.TextTruncate.AtEnd,
			Size = UDim2.fromOffset(155, 34), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0, baseH / 2),
			ZIndex = 6, Parent = r,
		}, { corner(9), new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }) }),
			"BackgroundColor3", "Bg")
		local bStroke = lib:_bind(new("UIStroke", { Transparency = 0.35, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = box }), "Color", "Accent")
		gloss(box, 0.8)
		local menu = lib:_bind(new("ScrollingFrame", {
			Visible = false, Size = UDim2.new(1, -20, 0, 0), Position = UDim2.fromOffset(10, baseH),
			BorderSizePixel = 0, ScrollBarThickness = 2, AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(), ZIndex = 20, Parent = r,
		}, { corner(8), new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
			 new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }) }),
			"BackgroundColor3", "Panel")
		lib:_bind(new("UIStroke", { Transparency = 0.3, Parent = menu }), "Color", "Stroke")
		local function mH(n) return math.min(n, 5) * 28 + 8 end
		local function closeMenu()
			menu.Visible = false
			tween(r, 0.2, { Size = UDim2.new(1, 0, 0, baseH) })
		end
		local function setText(v)
			suppress = true
			box.Text = tostring(v or "")
			suppress = false
		end
		local function showAC(filtered)
			for _, c in ipairs(menu:GetChildren()) do
				if c:IsA("TextButton") then c:Destroy() end
			end
			for i, it in ipairs(filtered) do
				local ob = lib:_bind(new("TextButton", {
					Text = tostring(it), Font = FONT, TextSize = 12, TextColor3 = TEXT, AutoButtonColor = false,
					BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = i, ZIndex = 21, Parent = menu,
				}, { corner(6) }), "BackgroundColor3", "Accent")
				ob.MouseEnter:Connect(function() tween(ob, 0.1, { BackgroundTransparency = 0.5 }) end)
				ob.MouseLeave:Connect(function() tween(ob, 0.1, { BackgroundTransparency = 1 }) end)
				ob.MouseButton1Click:Connect(function()
					setText(it)
					closeMenu()
					if o.Callback then task.spawn(o.Callback, box.Text) end
					if o.Key then lib:_queueSave() end
				end)
			end
			if #filtered > 0 then
				menu.Visible = true
				menu.Size = UDim2.new(1, -20, 0, mH(#filtered))
				tween(r, 0.2, { Size = UDim2.new(1, 0, 0, baseH + mH(#filtered) + 8) })
			else
				closeMenu()
			end
		end
		box:GetPropertyChangedSignal("Text"):Connect(function()
			if suppress then return end
			if o.Callback then task.spawn(o.Callback, box.Text) end
			local q = box.Text:lower()
			if q == "" or #items == 0 then closeMenu(); return end
			local matches = {}
			for _, it in ipairs(items) do
				if tostring(it):lower():find(q, 1, true) then
					matches[#matches + 1] = it
					if #matches >= 5 then break end
				end
			end
			showAC(matches)
		end)
		box.Focused:Connect(function() tween(bStroke, 0.15, { Transparency = 0 }) end)
		box.FocusLost:Connect(function()
			tween(bStroke, 0.15, { Transparency = 0.35 })
			if o.Key then lib:_queueSave() end
		end)
		local api = {}
		function api:Get() return box.Text end
		function api:Set(v, silent)
			setText(v)
			if o.Callback and not silent then task.spawn(o.Callback, box.Text) end
		end
		function api:SetOptions(newItems) items = newItems or {} end
		api._fire = function() if o.Callback then task.spawn(o.Callback, box.Text) end end
		lib:_regCfg(o.Key, api)
		return api
	end

	return sec
end

