-- ─────────────────────────────────────────────────────────────────────────────
-- AddTab
-- ─────────────────────────────────────────────────────────────────────────────

function Library:AddTab(name, icon)
	local lib = self
	local tab = { Name = name, _items = {}, _subs = {}, _pillBar = nil, _sub = nil }
	local hasIcon = type(icon) == "string" and icon ~= ""
	local iconOffset = hasIcon and 44 or 20

	local btn = self:_bind(new("TextButton", {
		Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 40), LayoutOrder = #self.Tabs + 1, Parent = self._tabList,
	}, { corner(10) }), "BackgroundColor3", "Item")
	tab.Tint = self:_bind(new("Frame", {
		Name = "Tint", BackgroundTransparency = 0.5, BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1), Visible = false, Parent = btn,
	}, { corner(10), new("UIGradient", { Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) }) }) }), "BackgroundColor3", "Accent")
	local _, shine, rim = gloss(btn, 1.2)
	tab.Shine, tab.Rim = shine, rim
	tab.Stroke = self:_bind(new("UIStroke", {
		Transparency = 0.3, Enabled = false, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = btn,
	}), "Color", "Accent")
	tab.Bar = self:_bind(new("Frame", {
		Size = UDim2.fromOffset(3, 20), Position = UDim2.new(0, 4, 0.5, -10),
		BorderSizePixel = 0, Visible = false, ZIndex = 3, Parent = btn,
	}, { corner(2) }), "BackgroundColor3", "Accent")

	btn.MouseEnter:Connect(function()
		if self.Current ~= tab then tween(btn, 0.18, { BackgroundTransparency = 0.6 }) end
	end)
	btn.MouseLeave:Connect(function()
		if self.Current ~= tab then tween(btn, 0.18, { BackgroundTransparency = 1 }) end
	end)

	if icon == "tag" then tagIcon(self, btn)
	elseif icon == "grid" then gridIcon(self, btn)
	elseif icon == "dot" then dotRingIcon(self, btn)
	elseif hasIcon and icon:match("^rbxassetid://") then imageIcon(self, btn, icon)
	elseif hasIcon then textIcon(self, btn, icon) end

	tab._tabLbl = new("TextLabel", {
		Name = "TabLabel", Text = name, Font = FONT, TextSize = 13, TextColor3 = TEXT,
		BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 3,
		Size = UDim2.new(1, -(iconOffset + 6), 1, 0), Position = UDim2.fromOffset(iconOffset, 0), Parent = btn,
	})
	tab.Button = btn

	local page = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = self._content })
	tab.Page = page
	tab._body = new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 3, ScrollBarImageTransparency = 0.5,
		AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = page,
	}, { new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		 new("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }) })
	self:_bind(tab._body, "ScrollBarImageColor3", "Accent")

	btn.MouseButton1Click:Connect(function() self:_select(tab) end)
	table.insert(self.Tabs, tab)
	if #self.Tabs == 1 then self:_select(tab) end

	function tab:AddSubTab(subName)
		if not tab._pillBar then
			tab._pillBar = lib:_bind(new("ScrollingFrame", {
				Size = UDim2.new(1, -6, 0, 44), BackgroundTransparency = 0.2, BorderSizePixel = 0,
				ScrollBarThickness = 0, AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(),
				ScrollingDirection = Enum.ScrollingDirection.X, Parent = page,
			}, { corner(10),
				 new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6),
					VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
				 new("UIPadding", { PaddingLeft = UDim.new(0, 8) }) }), "BackgroundColor3", "Panel")
			lib:_bind(new("UIStroke", { Transparency = 0.4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = tab._pillBar }), "Color", "Stroke")
			new("UIGradient", { Rotation = 90, Color = ColorSequence.new(WHITE, Color3.fromRGB(170, 170, 170)), Parent = tab._pillBar })
			if tab._body then tab._body:Destroy() end
			tab._body = nil
		end
		local sub = { Name = subName }
		local pill = lib:_bind(new("TextButton", {
			Text = subName, Font = FONT_B, TextSize = 12, TextColor3 = SUBTEXT,
			AutoButtonColor = false, BackgroundTransparency = 1,
			AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 30),
			LayoutOrder = #tab._subs + 1, Parent = tab._pillBar,
		}, { corner(8), new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }) }),
			"BackgroundColor3", "Accent")
		local _, pShine, pRim = gloss(pill, 1.5)
		sub.Shine, sub.Rim = pShine, pRim
		sub.Glow = lib:_bind(new("UIStroke", {
			Thickness = 2, Transparency = 0.6, Enabled = false, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = pill,
		}), "Color", "Accent")
		pill.MouseEnter:Connect(function() if tab._sub ~= sub then tween(pill, 0.15, { TextColor3 = TEXT }) end end)
		pill.MouseLeave:Connect(function() if tab._sub ~= sub then tween(pill, 0.15, { TextColor3 = SUBTEXT }) end end)
		sub.Body = new("ScrollingFrame", {
			Size = UDim2.new(1, 0, 1, -52), Position = UDim2.fromOffset(0, 52),
			BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
			AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Visible = false, Parent = page,
		}, { new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
			 new("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }) })
		local function pick()
			for _, s in ipairs(tab._subs) do
				local on = s == sub
				s.Body.Visible, s.Shine.Visible, s.Rim.Visible, s.Glow.Enabled = on, on, on, on
				tween(s.Pill, 0.2, { BackgroundTransparency = on and 0 or 1, TextColor3 = on and WHITE or SUBTEXT })
			end
			tab._sub = sub
			if lib.Current == tab then lib:_select(tab) end
		end
		sub.Pill = pill
		pill.MouseButton1Click:Connect(pick)
		table.insert(tab._subs, sub)
		if #tab._subs == 1 then pick() else pShine.Visible, pRim.Visible = false, false end
		function sub:AddSection(n) return lib:_section(tab, sub.Body, n) end
		return sub
	end

	function tab:AddSection(n)
		local body = tab._body or (tab._subs[1] and tab._subs[1].Body)
		return lib:_section(tab, body, n)
	end

	return tab
end

