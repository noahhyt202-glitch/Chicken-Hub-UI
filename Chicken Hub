	-- Progress bar countdown
	TweenService:Create(prog, TweenInfo.new(duration, Enum.EasingStyle.Linear),
		{ Size = UDim2.fromScale(0, 1) }):Play()

	local dismissed = false
	local function dismiss()
		if dismissed then return end
		dismissed = true
		tween(toast, 0.25, { Position = UDim2.fromOffset(310, 0), BackgroundTransparency = 1 })
		task.delay(0.3, function()
			if toast.Parent then toast:Destroy() end
		end)
	end

	closeBtn.MouseButton1Click:Connect(dismiss)
	task.delay(duration, function()
		if toast.Parent then dismiss() end
	end)
end

function Library:WatchRemote(remote, displayName, interval)
	interval    = interval or 30
	displayName = displayName or (remote and remote.Name) or "Unknown"

	local function check()
		if not remote or not remote.Parent then
			self:Notify({
				Title   = "Remote Offline",
				Message = displayName .. " is not responding — it may have been patched.",
				Type    = "error",
				Duration = 8,
			})
			return false
		end
		local ok, err = pcall(function()
			if remote:IsA("RemoteFunction") then
				remote:InvokeServer()
			elseif remote:IsA("RemoteEvent") then
				remote:FireServer()
			end
		end)
		if not ok then
			self:Notify({
				Title   = "Remote Error",
				Message = displayName .. " — " .. tostring(err):sub(1, 70),
				Type    = "warn",
				Duration = 6,
			})
		end
		return ok
	end

	-- Initial check
	task.defer(check)

	-- Periodic watcher
	task.spawn(function()
		while true do
			task.wait(interval)
			if not remote or not remote.Parent then
				check()
				break
			end
			check()
		end
	end)

	return { Check = check }
end

