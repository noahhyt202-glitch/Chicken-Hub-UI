local function tagIcon(lib, parent)
	local holder = new("Frame", {
		Name = "TagIcon", BackgroundTransparency = 1,
		Size = UDim2.fromOffset(18,18), Position = UDim2.new(0,14,0.5,-9), Parent = parent,
	})
	local pts = {
		Vector2.new(3,3), Vector2.new(10,3), Vector2.new(21,14),
		Vector2.new(14,21), Vector2.new(3,10), Vector2.new(3,3),
	}
	for i = 1, #pts - 1 do
		local a, b  = pts[i] * 0.75, pts[i+1] * 0.75
		local delta = b - a; local mid = (a+b)/2
		lib:_bind(new("Frame", {
			BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5,0.5),
			Position = UDim2.fromOffset(mid.X, mid.Y),
			Size     = UDim2.fromOffset(delta.Magnitude+1, 1.6),
			Rotation = math.deg(math.atan2(delta.Y, delta.X)), Parent = holder,
		}, {corner(1)}), "BackgroundColor3","Accent")
	end
	lib:_bind(new("Frame",{
		BorderSizePixel=0, Size=UDim2.fromOffset(2.5,2.5),
		Position=UDim2.fromOffset(4.5,4.5), Parent=holder,
	},{corner(2)}), "BackgroundColor3","Accent")
end

