--[[
	ChickenUI v3 – glossy dark sidebar UI library

	Quick start:
		local Lib = ChickenUI.new({
			Title = "My Hub", Version = "v1.0",
			Theme = "Chicken",                       -- optional
			ToggleKey = Enum.KeyCode.RightControl,   -- optional
			OnClose = function() end,                -- optional, runs once when the window closes
		})
		Lib:SetConfig("MyHub")                     -- saves controls that have a Key + the theme

		Lib:AddDashboardTab()
		Lib:AddNotificationsTab()

		local tab = Lib:AddTab("Combat", "tag")    -- icons: "tag", "grid", "dot", "rbxassetid://…", or any text/emoji
		local sec = tab:AddSection("Settings")
		sec:AddToggle({ Name = "Aimbot", Key = "aimbot", Default = false, Callback = function(v) end })
		sec:AddButton({ Name = "Teleport", Callback = function() end })

		Lib:Notify({ Title = "Ready", Message = "Hub loaded!", Type = "success" })   -- info | success | warn | error
		Lib:WatchRemote(remote, "SomeRemote")      -- existence check only; pass true as 4th arg to also ping it
]]

