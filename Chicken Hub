-- ─────────────────────────────────────────────────────────────────────────────
-- Helpers
-- ─────────────────────────────────────────────────────────────────────────────

local function new(class, props, children)
	local o = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else o[k] = v end
	end
	for _, c in ipairs(children or {}) do c.Parent = o end
	if parent then o.Parent = parent end
	return o
end

local function corner(r) return new("UICorner", { CornerRadius = UDim.new(0, r or 8) }) end

local function tween(o, t, p, style)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), p)
	tw:Play()
	return tw
end

local function fadeEdges(mid)
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, mid or 0),
		NumberSequenceKeypoint.new(1, 1),
	})
end

-- Vertical sheen + bright top half + 1px rim highlight. Returns inst, shine, rim.
local function gloss(inst, strength)
	strength = strength or 1
	new("UIGradient", {
		Name = "GlossGrad", Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0,   WHITE),
			ColorSequenceKeypoint.new(0.5, WHITE:Lerp(BLACK, 0.12 * strength)),
			ColorSequenceKeypoint.new(1,   WHITE:Lerp(BLACK, 0.34 * strength)),
		}),
		Parent = inst,
	})
	local uc = inst:FindFirstChildOfClass("UICorner")
	local cr = uc and uc.CornerRadius or UDim.new(0, 8)
	local shine = new("Frame", {
		Name = "Shine", BackgroundColor3 = WHITE, BorderSizePixel = 0,
		BackgroundTransparency = math.clamp(1 - 0.17 * strength, 0, 1),
		Size = UDim2.new(1, -2, 0.5, 0), Position = UDim2.fromOffset(1, 1),
		Active = false, Parent = inst,
	}, { new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0, 1) }), new("UICorner", { CornerRadius = cr }) })
	local rim = new("Frame", {
		Name = "Rim", BackgroundColor3 = WHITE, BorderSizePixel = 0,
		BackgroundTransparency = math.clamp(1 - 0.32 * strength, 0, 1),
		Size = UDim2.new(1, -16, 0, 1), Position = UDim2.fromOffset(8, 1),
		Active = false, Parent = inst,
	}, { new("UIGradient", { Transparency = fadeEdges(0) }) })
	return inst, shine, rim
end

-- Diagonal light sweep across an element; returns a function that plays it.
local function sweep(inst)
	local s = new("Frame", {
		Name = "Sweep", BackgroundColor3 = WHITE, BackgroundTransparency = 0.86,
		BorderSizePixel = 0, Rotation = 12,
		Size = UDim2.new(0, 46, 1.6, 0), Position = UDim2.new(0, -80, -0.3, 0),
		Active = false, Parent = inst,
	}, { new("UIGradient", { Transparency = fadeEdges(0) }) })
	inst.ClipsDescendants = true
	return function()
		s.Position = UDim2.new(0, -80, -0.3, 0)
		tween(s, 0.65, { Position = UDim2.new(1, 30, -0.3, 0) }, Enum.EasingStyle.Sine)
	end
end

local function timeStr() return os.date("%H:%M:%S") end

local function fmtDuration(sec)
	sec = math.floor(sec)
	local h, m, s = math.floor(sec / 3600), math.floor(sec / 60) % 60, sec % 60
	if h > 0 then return ("%d:%02d:%02d"):format(h, m, s) end
	return ("%02d:%02d"):format(m, s)
end

local function decimalsOf(n)
	local d = tostring(n):match("%.(%d+)$")
	return d and #d or 0
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Library
-- ─────────────────────────────────────────────────────────────────────────────

local Library = {}
Library.__index = Library
Library.Themes = Themes

function Library:_bind(inst, prop, key)
	local list = self._themed
	list[#list + 1] = { inst, prop, key }
	inst[prop] = self.Theme[key]
	if #list % 256 == 0 then self:_compact() end
	return inst
end

function Library:_compact()
	local keep = {}
	for _, t in ipairs(self._themed) do
		if t[1].Parent then keep[#keep + 1] = t end
	end
	self._themed = keep
end

function Library:SetTheme(name)
	if not Themes[name] then name = "Red" end
	self.Theme, self.ThemeName = Themes[name], name
	self:_compact()
	for _, t in ipairs(self._themed) do t[1][t[2]] = self.Theme[t[3]] end
	if self._themeLabel then self._themeLabel.Text = name end
	for _, fn in ipairs(self._onTheme) do pcall(fn, self.Theme) end
	self:_queueSave()
end

function Library:NextTheme()
	local i = table.find(THEME_ORDER, self.ThemeName) or 0
	self:SetTheme(THEME_ORDER[i % #THEME_ORDER + 1])
end

function Library:_conn(c) table.insert(self._conns, c); return c end

function Library:_alive() return not self._destroyed and self.Gui ~= nil and self.Gui.Parent ~= nil end

function Library:Toggle(v)
	if not self.Root then return end
	if v == nil then v = not self.Root.Visible end
	self.Root.Visible = v
end

function Library:Destroy()
	if self._destroyed then return end
	self._destroyed = true
	for _, c in ipairs(self._conns) do pcall(function() c:Disconnect() end) end
	self._conns = {}
	if self._configFile and self._savePending then self:SaveConfig() end
	if self.Gui then pcall(function() self.Gui:Destroy() end) end
	if self._onClose then task.spawn(self._onClose) end
end

-- ─────────────────────────────── Config system ───────────────────────────────

function Library:SetConfig(name)
	self._configFile = name
	local ok, raw = pcall(readfile, name .. "_config.json")
	if ok and type(raw) == "string" and #raw > 0 then
		local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw)
		if ok2 and type(data) == "table" then
			self._configData = data
			if type(data._theme) == "string" and Themes[data._theme] then
				self._suppressSave = true
				self:SetTheme(data._theme)
				self._suppressSave = false
			end
			for key, api in pairs(self._config) do
				if data[key] ~= nil then self:_applyCfg(api, data[key]) end
			end
		end
	end
	return self
end

function Library:SaveConfig()
	if not self._configFile then return end
	local data = { _theme = self.ThemeName }
	for key, api in pairs(self._config) do
		local ok, v = pcall(api.Get, api)
		if ok and v ~= nil then data[key] = v end
	end
	local ok, json = pcall(HttpService.JSONEncode, HttpService, data)
	if ok then pcall(writefile, self._configFile .. "_config.json", json) end
end

function Library:_queueSave()
	if not self._configFile or self._suppressSave or self._savePending then return end
	self._savePending = true
	task.delay(0.6, function()
		self._savePending = false
		self:SaveConfig()
	end)
end

-- Saved values are applied silently, then the control's callback is deferred
-- so the saved state actually takes effect once the caller's script has finished wiring.
function Library:_applyCfg(api, v)
	self._suppressSave = true
	pcall(api.Set, api, v, true)
	self._suppressSave = false
	if api._fire then task.defer(api._fire) end
end

function Library:_regCfg(key, api)
	if not key then return end
	self._config[key] = api
	local orig = api.Set
	api.Set = function(s, v, silent)
		orig(s, v, silent)
		if not silent then self:_queueSave() end
	end
	if self._configData[key] ~= nil then self:_applyCfg(api, self._configData[key]) end
end

-- ─────────────────────────── Notification system ─────────────────────────────

function Library:Notify(opts)
	if type(opts) == "string" then opts = { Message = opts } end
	opts = opts or {}
	local entry = {
		Title   = tostring(opts.Title or "Notice"),
		Message = tostring(opts.Message or ""),
		Type    = NOTIF_COLORS[opts.Type] and opts.Type or "info",
		TimeStr = timeStr(),
	}
	if not opts.NoLog then
		table.insert(self._notifications, 1, entry)
		while #self._notifications > MAX_LOG do table.remove(self._notifications) end
		self:_refreshNotifLog()
	end
	if self._toastsEnabled == false and not opts.Force then return end
	if not self._notifContainer or not self._notifContainer.Parent then return end
	self:_toast(entry, tonumber(opts.Duration) or 5)
end

function Library:_toast(t, duration)
	local container = self._notifContainer
	local color = NOTIF_COLORS[t.Type]
	self._toastSeq += 1

	local slots = {}
	for _, c in ipairs(container:GetChildren()) do
		if c.Name == "ToastSlot" then slots[#slots + 1] = c end
	end
	table.sort(slots, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
	for i = MAX_TOASTS, #slots do slots[i]:Destroy() end

	-- The slot is what the list layout positions; the card inside it is free to slide.
	local slot = new("Frame", {
		Name = "ToastSlot", BackgroundTransparency = 1, ClipsDescendants = false,
		Size = UDim2.fromOffset(TOAST_W, TOAST_H), LayoutOrder = -self._toastSeq,
		Parent = container,
	})
	local card = new("Frame", {
		Name = "Toast", BackgroundColor3 = self.Theme.Panel, BackgroundTransparency = 0.04,
		Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(TOAST_W + 30, 0),
		ClipsDescendants = true, Parent = slot,
	}, { corner(12) })
	gloss(card, 0.9)
	new("UIStroke", { Color = color, Transparency = 0.45, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = card })
	new("Frame", {
		BackgroundColor3 = color, BackgroundTransparency = 0.78, BorderSizePixel = 0,
		Size = UDim2.new(0.6, 0, 1, 0), Parent = card,
	}, { new("UIGradient", { Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) }) }) })
	new("Frame", {
		BackgroundColor3 = color, BorderSizePixel = 0,
		Size = UDim2.new(0, 4, 1, -16), Position = UDim2.fromOffset(6, 8), Parent = card,
	}, { corner(2) })
	local dot = new("Frame", {
		BackgroundColor3 = color, BorderSizePixel = 0,
		Size = UDim2.fromOffset(8, 8), Position = UDim2.fromOffset(18, 12), Parent = card,
	}, { corner(4) })
	new("UIStroke", { Color = color, Thickness = 3, Transparency = 0.6, Parent = dot })
	new("TextLabel", {
		Text = t.Title, Font = FONT_B, TextSize = 13, TextColor3 = TEXT,
		BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, -120, 0, 18), Position = UDim2.fromOffset(32, 7), Parent = card,
	})
	new("TextLabel", {
		Text = t.TimeStr, Font = FONT, TextSize = 10, TextColor3 = SUBTEXT,
		BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Right,
		Size = UDim2.fromOffset(56, 18), AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -30, 0, 7), Parent = card,
	})
	local closeBtn = new("TextButton", {
		Text = "×", Font = FONT_B, TextSize = 18, TextColor3 = SUBTEXT,
		BackgroundTransparency = 1, AutoButtonColor = false,
		Size = UDim2.fromOffset(24, 24), AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -4, 0, 4), Parent = card,
	})
	closeBtn.MouseEnter:Connect(function() closeBtn.TextColor3 = TEXT end)
	closeBtn.MouseLeave:Connect(function() closeBtn.TextColor3 = SUBTEXT end)
	new("TextLabel", {
		Text = t.Message, Font = FONT, TextSize = 12, TextColor3 = SUBTEXT,
		BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, -30, 0, 32), Position = UDim2.fromOffset(18, 28), Parent = card,
	})
	local progBg = new("Frame", {
		BackgroundColor3 = BLACK, BackgroundTransparency = 0.6, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 3), Position = UDim2.new(0, 0, 1, -3), Parent = card,
	})
	local prog = new("Frame", {
		BackgroundColor3 = color, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = progBg,
	})

	tween(card, 0.35, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
	TweenService:Create(prog, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(0, 1) }):Play()

	local dismissed = false
	local function dismiss()
		if dismissed or not slot.Parent then return end
		dismissed = true
		tween(card, 0.25, { Position = UDim2.fromOffset(TOAST_W + 30, 0) })
		task.delay(0.22, function()
			if not slot.Parent then return end
			tween(slot, 0.2, { Size = UDim2.fromOffset(TOAST_W, 0) })
			task.delay(0.22, function() if slot.Parent then slot:Destroy() end end)
		end)
	end
	closeBtn.MouseButton1Click:Connect(dismiss)
	task.delay(duration, dismiss)
end

-- Watches a remote. By default only checks that it still exists (no side effects).
-- Pass ping = true to also call it with no arguments; only do that for harmless remotes.
function Library:WatchRemote(remote, displayName, interval, ping)
	interval = tonumber(interval) or 30
	displayName = displayName or (typeof(remote) == "Instance" and remote.Name) or "Remote"
	local lastUp

	local function check()
		local up = typeof(remote) == "Instance" and remote.Parent ~= nil
		local err
		if up and ping then
			local ok, e = pcall(function()
				if remote:IsA("RemoteFunction") then remote:InvokeServer()
				elseif remote:IsA("RemoteEvent") then remote:FireServer() end
			end)
			if not ok then up, err = false, e end
		end
		if up ~= lastUp then
			if up and lastUp == false then
				self:Notify({ Title = "Remote Back Online", Message = displayName, Type = "success" })
			elseif not up then
				self:Notify({
					Title = err and "Remote Error" or "Remote Offline",
					Message = displayName .. (err and (": " .. tostring(err):sub(1, 70)) or " is missing — it may have been patched."),
					Type = "error", Duration = 8,
				})
			end
			lastUp = up
		end
		return up
	end

	task.defer(check)
	task.spawn(function()
		while self:_alive() do
			task.wait(interval)
			if not self:_alive() then break end
			check()
		end
	end)
	return { Check = check }
end

-- ─────────────────────────────── Constructor ─────────────────────────────────

function Library.new(opts)
	opts = opts or {}
	local W = (opts.Size and opts.Size.X) or 620
	local H = (opts.Size and opts.Size.Y) or 400

	local self = setmetatable({
		_themed = {}, _onTheme = {}, _conns = {}, Tabs = {},
		Theme = Themes.Red, ThemeName = "Red",
		_config = {}, _configData = {}, _configFile = nil,
		_notifications = {}, _notifLog = nil, _toastSeq = 0,
		_onClose = opts.OnClose, _version = opts.Version,
		_startTime = os.clock(),
	}, Library)
	if opts.Theme and Themes[opts.Theme] then self.Theme, self.ThemeName = Themes[opts.Theme], opts.Theme end

	local parentGui = (type(gethui) == "function" and gethui()) or player:WaitForChild("PlayerGui")
	local guiName = "ChickenUI_" .. tostring(opts.Name or opts.Title or "Hub")
	local old = parentGui:FindFirstChild(guiName)
	if old then old:Destroy() end

	local gui = new("ScreenGui", {
		Name = guiName, ResetOnSpawn = false, IgnoreGuiInset = false,
		DisplayOrder = opts.DisplayOrder or 100,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	gui.Parent = parentGui
	gui.Destroying:Connect(function() self:Destroy() end)
	self.Gui = gui

	-- Toast container (top-right, outside the window)
	self._notifContainer = new("Frame", {
		Name = "NotifContainer", BackgroundTransparency = 1,
		Size = UDim2.fromOffset(TOAST_W, 0), AutomaticSize = Enum.AutomaticSize.Y,
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 16),
		ZIndex = 100, Parent = gui,
	}, { new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }) })

	-- Root holds shadow + window so one UIScale scales both.
	local root = new("Frame", {
		Name = "Root", BackgroundTransparency = 1,
		Size = UDim2.fromOffset(W, H), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5), Parent = gui,
	})
	self.Root = root
	new("ImageLabel", {
		Name = "Shadow", Image = "rbxassetid://6014261993",
		ImageColor3 = BLACK, ImageTransparency = 0.38,
		ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(49, 49, 450, 450),
		BackgroundTransparency = 1, Size = UDim2.new(1, 64, 1, 64),
		Position = UDim2.fromOffset(-32, -24), ZIndex = 0, Parent = root,
	})
	local uiScale = new("UIScale", { Scale = 1, Parent = root })
	self._scale = uiScale

	local function fitScale()
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
		return math.clamp(math.min((vp.X - 24) / W, (vp.Y - 72) / H), 0.45, 1)
	end

	-- ── Window ────────────────────────────────────────────────────────────────
	local main = self:_bind(new("Frame", {
		Name = "Main", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0.04,
		ClipsDescendants = true, ZIndex = 1, Parent = root,
	}, { corner(14) }), "BackgroundColor3", "Bg")
	self.Main = main
	self:_bind(new("UIStroke", { Thickness = 1, Transparency = 0.1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = main }),
		"Color", "Stroke")
	new("UIGradient", {
		Rotation = 125,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, WHITE),
			ColorSequenceKeypoint.new(0.55, Color3.fromRGB(190, 190, 190)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(140, 140, 140)),
		}),
		Parent = main,
	})

	-- Glass layers: accent glow at the bottom, white sheen at the top, 1px inner rim.
	local accentGlow = self:_bind(new("Frame", {
		Name = "AccentGlow", BackgroundTransparency = 1, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0.55, 0), Position = UDim2.new(0, 0, 0.45, 0), Parent = main,
	}, { corner(14), new("UIGradient", { Rotation = -90, Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.6, 0.7), NumberSequenceKeypoint.new(1, 1) }) }) }),
		"BackgroundColor3", "Accent")
	new("Frame", {
		Name = "WindowShine", BackgroundColor3 = WHITE, BackgroundTransparency = 0.9,
		BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 140), Parent = main,
	}, { corner(14), new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0, 1) }) })
	new("Frame", {
		Name = "InnerRim", BackgroundColor3 = WHITE, BackgroundTransparency = 0.72,
		BorderSizePixel = 0, Size = UDim2.new(1, -28, 0, 1), Position = UDim2.fromOffset(14, 1), Parent = main,
	}, { new("UIGradient", { Transparency = fadeEdges(0) }) })

	-- Accent edge with a travelling highlight
	local edge = self:_bind(new("Frame", {
		Name = "AccentEdge", BorderSizePixel = 0, ClipsDescendants = true,
		Size = UDim2.new(1, -40, 0, 2), Position = UDim2.fromOffset(20, 0), Parent = main,
	}, { new("UIGradient", { Transparency = fadeEdges(0.05) }) }), "BackgroundColor3", "Accent")
	local edgeSheen = new("Frame", {
		BackgroundColor3 = WHITE, BorderSizePixel = 0,
		Size = UDim2.new(0.25, 0, 1, 0), Position = UDim2.new(-0.3, 0, 0, 0), Parent = edge,
	}, { new("UIGradient", { Transparency = fadeEdges(0.1) }) })
	task.spawn(function()
		while self:_alive() do
			edgeSheen.Position = UDim2.new(-0.3, 0, 0, 0)
			tween(edgeSheen, 1.8, { Position = UDim2.new(1.05, 0, 0, 0) }, Enum.EasingStyle.Sine)
			task.wait(4.5)
