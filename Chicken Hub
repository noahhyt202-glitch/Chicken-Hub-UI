function Library:_refreshNotifLog()
	if self._notifCount then
		local n = #self._notifications
		self._notifCount:Set(n == 0 and "No notifications yet." or (n .. " notification" .. (n == 1 and "" or "s") .. " (newest first)"))
	end
	local list = self._notifLog
	if not list or not list.Parent then return end

	for _, c in ipairs(list:GetChildren()) do
		if c.Name == "NotifEntry" or c.Name == "NotifEmpty" then c:Destroy() end
	end

	if #self._notifications == 0 then
		new("TextLabel", {
			Name = "NotifEmpty", Text = "Nothing here yet.", Font = FONT, TextSize = 12, TextColor3 = SUBTEXT,
			BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32), Parent = list,
		})
		return
	end

	for i, t in ipairs(self._notifications) do
		if i > MAX_LOG_SHOWN then break end
		local color = NOTIF_COLORS[t.Type] or self.Theme.Accent
		local entry = self:_bind(new("Frame", {
			Name = "NotifEntry", Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 0.2,
			ClipsDescendants = true, LayoutOrder = i, Parent = list,
		}, { corner(10) }), "BackgroundColor3", "Item")
		gloss(entry, 0.8)
		new("Frame", {
			BackgroundColor3 = color, BorderSizePixel = 0,
			Size = UDim2.new(0, 3, 1, -12), Position = UDim2.fromOffset(5, 6), Parent = entry,
		}, { corner(2) })
		new("Frame", {
			BackgroundColor3 = color, BorderSizePixel = 0,
			Size = UDim2.fromOffset(7, 7), Position = UDim2.fromOffset(14, 10), Parent = entry,
		}, { corner(4) })
		new("TextLabel", {
			Text = t.Title, Font = FONT_B, TextSize = 12, TextColor3 = TEXT,
			BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			Size = UDim2.new(1, -100, 0, 16), Position = UDim2.fromOffset(26, 6), Parent = entry,
		})
		new("TextLabel", {
			Text = t.TimeStr, Font = FONT, TextSize = 10, TextColor3 = SUBTEXT,
			BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Right,
			Size = UDim2.fromOffset(60, 14), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Parent = entry,
		})
		new("TextLabel", {
			Text = t.Message, Font = FONT, TextSize = 11, TextColor3 = SUBTEXT,
			BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true, TextTruncate = Enum.TextTruncate.AtEnd,
			Size = UDim2.new(1, -30, 0, 26), Position = UDim2.fromOffset(14, 26), Parent = entry,
		})
		new("UIStroke", { Color = color, Transparency = 0.7, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = entry })
	end
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Dashboard tab   AddDashboardTab({ Name = "Dashboard", Icon = "grid" })
-- Returns the tab; tab.StatusText is an AddText api you can :Set() yourself.
-- ─────────────────────────────────────────────────────────────────────────────

function Library:AddDashboardTab(opts)
	opts = opts or {}
	local tab = self:AddTab(opts.Name or "Dashboard", opts.Icon or "grid")

	local plrSec = tab:AddSection("Player")
	plrSec:AddText("User: " .. player.Name)
	if player.DisplayName ~= player.Name then plrSec:AddText("Display: " .. player.DisplayName) end
	plrSec:AddText("User ID: " .. player.UserId)
	plrSec:AddText("Account age: " .. player.AccountAge .. " day" .. (player.AccountAge == 1 and "" or "s"))

	local gameSec = tab:AddSection("Game")
	local gameName = gameSec:AddText("Game: fetching…")
	gameSec:AddText("Place ID: " .. game.PlaceId)
	gameSec:AddText("Server: " .. (game.JobId ~= "" and (game.JobId:sub(1, 18) .. "…") or "Studio / local"))
	local serverCount = gameSec:AddText("")
	local function updateCount()
		if not self:_alive() then return end
		local n, max = #Players:GetPlayers(), Players.MaxPlayers
		serverCount:Set(("Players: %d / %d"):format(n, max))
	end
	updateCount()
	self:_conn(Players.PlayerAdded:Connect(updateCount))
	self:_conn(Players.PlayerRemoving:Connect(function() task.defer(updateCount) end))
	task.spawn(function()
		local ok, info = pcall(MarketplaceService.GetProductInfo, MarketplaceService, game.PlaceId)
		if not self:_alive() then return end
		gameName:Set("Game: " .. ((ok and info and info.Name) or "(unavailable)"))
	end)

	local hubSec = tab:AddSection("Hub")
	hubSec:AddText("Version: " .. ((self._version and self._version ~= "") and self._version or "—"))
	local themeDisplay = hubSec:AddText("Theme: " .. self.ThemeName)
	table.insert(self._onTheme, function() themeDisplay:Set("Theme: " .. self.ThemeName) end)
	local cfgDisplay = hubSec:AddText("")
	local uptime = hubSec:AddText("Session: 00:00")

	local connSec = tab:AddSection("Connection")
	local statusApi = connSec:AddText("● Connected")
	local pingText = connSec:AddText("Ping: …")
	local fpsText = connSec:AddText("FPS: …")
	tab.StatusText = statusApi

	local frames = 0
	self:_conn(RunService.Heartbeat:Connect(function() frames += 1 end))

	local lost = false
	self:_conn(GuiService.ErrorMessageChanged:Connect(function(msg)
		if lost or not msg or msg == "" then return end
		lost = true
		statusApi:Set("○ Disconnected")
		self:Notify({ Title = "Connection Lost", Message = tostring(msg):sub(1, 90), Type = "error", Duration = 10 })
	end))

	local function getPing()
		local ok, p = pcall(function() return player:GetNetworkPing() * 1000 end)
		if ok and p and p > 0 then return p end
		ok, p = pcall(function() return StatsService.Network.ServerStatsItem["Data Ping"]:GetValue() end)
		return ok and p or nil
	end

	task.spawn(function()
		while self:_alive() do
			cfgDisplay:Set("Config: " .. (self._configFile and (self._configFile .. "_config.json") or "not set"))
			uptime:Set("Session: " .. fmtDuration(os.clock() - self._startTime))
			local p = getPing()
			pingText:Set(p and ("Ping: %d ms"):format(math.floor(p + 0.5)) or "Ping: n/a")
			fpsText:Set("FPS: " .. frames)
			frames = 0
			task.wait(1)
		end
	end)

	connSec:AddButton({
		Name = "Copy Server ID", Description = "Copies the JobId so friends can join you", ButtonText = "⧉  Copy",
		Callback = function()
			local ok = type(setclipboard) == "function" and pcall(setclipboard, game.JobId)
			self:Notify({
				Title = ok and "Copied" or "Clipboard unavailable",
				Message = ok and "Server ID copied to clipboard." or "Your executor doesn't support setclipboard.",
				Type = ok and "success" or "warn", Duration = 3, NoLog = true,
			})
		end,
	})

	return tab
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Notifications tab   AddNotificationsTab({ Name = "Notifications", Icon = "dot" })
-- Every Lib:Notify() call is logged here automatically.
-- ─────────────────────────────────────────────────────────────────────────────

function Library:AddNotificationsTab(opts)
	opts = opts or {}
	local tab = self:AddTab(opts.Name or "Notifications", opts.Icon or "dot")

	local ctrlSec = tab:AddSection("Controls")
	self._notifCount = ctrlSec:AddText("")
	ctrlSec:AddToggle({
		Name = "Show toasts", Description = "Pop-ups in the top-right corner",
		Key = "_notif_toasts", Default = self._toastsEnabled ~= false,
		Callback = function(v) self._toastsEnabled = v end,
	})
	ctrlSec:AddButton({
		Name = "Test notification", ButtonText = "▶  Test",
		Callback = function()
			self:Notify({ Title = "Test", Message = "Notifications are working.", Type = "info", Duration = 3, Force = true })
		end,
	})
	ctrlSec:AddButton({
		Name = "Clear log", ButtonText = "✕  Clear",
		Callback = function()
			self._notifications = {}
			self:_refreshNotifLog()
			self:Notify({ Title = "Log cleared", Message = "All notifications removed.", Type = "info", Duration = 2, NoLog = true })
		end,
	})

	local logSec = tab:AddSection("Log")
	self._notifLog = logSec._listFrame
	self:_refreshNotifLog()

	return tab
end

return Library
