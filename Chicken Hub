--[[
	ChickenUI - glossy dark sidebar UI library
	Provides: Window, Tabs, Sub-tabs, Sections, Toggles, Sliders, Buttons,
	          Dropdowns, TextInputs, Labels, Text blocks, Theming.

	Usage:
		local Lib = ChickenUI.new({ Title = "My Hub", Version = "v1" })
		local tab = Lib:AddTab("Main", "tag")
		local sec = tab:AddSection("Combat")
		sec:AddToggle({ Name = "Aimbot", Default = false, Callback = function(v) ... end })
		sec:AddSlider({ Name = "FOV", Min = 1, Max = 360, Default = 90, Callback = function(v) ... end })
		sec:AddButton({ Name = "Do Thing", Callback = function() ... end })
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

local Themes = {
	Chicken     = { Accent = Color3.fromRGB(242, 198, 64),  Bg = Color3.fromRGB(26, 22, 13),  Panel = Color3.fromRGB(42, 35, 20),  Item = Color3.fromRGB(54, 45, 26),  Stroke = Color3.fromRGB(104, 86, 46)  },
	Red         = { Accent = Color3.fromRGB(230, 40, 50),   Bg = Color3.fromRGB(10, 10, 12),  Panel = Color3.fromRGB(20, 20, 23),  Item = Color3.fromRGB(30, 29, 33),  Stroke = Color3.fromRGB(92, 28, 34)   },
	Blue        = { Accent = Color3.fromRGB(70, 130, 230),  Bg = Color3.fromRGB(16, 20, 30),  Panel = Color3.fromRGB(26, 32, 46),  Item = Color3.fromRGB(34, 42, 60),  Stroke = Color3.fromRGB(55, 70, 100)  },
	Green       = { Accent = Color3.fromRGB(70, 200, 120),  Bg = Color3.fromRGB(16, 26, 20),  Panel = Color3.fromRGB(26, 40, 32),  Item = Color3.fromRGB(34, 52, 42),  Stroke = Color3.fromRGB(55, 90, 70)   },
	-- ✨ Custom themes
	GirlChicken = { Accent = Color3.fromRGB(255, 105, 180), Bg = Color3.fromRGB(28, 18, 24),  Panel = Color3.fromRGB(48, 28, 40),  Item = Color3.fromRGB(62, 36, 52),  Stroke = Color3.fromRGB(180, 80, 130) },
	Purple      = { Accent = Color3.fromRGB(160, 80, 255),  Bg = Color3.fromRGB(14, 10, 22),  Panel = Color3.fromRGB(28, 18, 44),  Item = Color3.fromRGB(38, 26, 58),  Stroke = Color3.fromRGB(90, 50, 150)  },
}
local TEXT, SUBTEXT = Color3.fromRGB(240, 234, 220), Color3.fromRGB(168, 158, 138)
local FONT, FONT_B = Enum.Font.Gotham, Enum.Font.GothamBold

local Library = {}
Library.__index = Library

local function new(class, props, children)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	for _, c in ipairs(children or {}) do c.Parent = o end
	return o
end
local function corner(r) return new("UICorner", { CornerRadius = UDim.new(0, r or 8) }) end
local function tween(o, t, p) TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quint), p):Play() end

local function gloss(inst, strength)
	strength = strength or 1
	new("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
			ColorSequenceKeypoint.new(1, Color3.new(1, 1, 1):Lerp(Color3.new(0, 0, 0), 0.28 * strength)),
		}),
		Parent = inst,
	})
	local r = inst:FindFirstChildOfClass("UICorner")
	local shine = new("Frame", {
		Name = "Shine", BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1 - 0.13 * strength, BorderSizePixel = 0,
		Size = UDim2.new(1, -2, 0.5, 0), Position = UDim2.fromOffset(1, 1), ZIndex = inst.ZIndex, Parent = inst,
	}, {
		new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0, 1) }),
		new("UICorner", { CornerRadius = r and r.CornerRadius or UDim.new(0, 8) }),
	})
	shine.Active = false
	new("Frame", {
		Name = "Rim", BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1 - 0.22 * strength, BorderSizePixel = 0,
		Size = UDim2.new(1, -16, 0, 1), Position = UDim2.fromOffset(8, 1), ZIndex = inst.ZIndex, Parent = inst,
	}, { new("UIGradient", { Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }) }) })
	return inst
end
local function sweep(inst)
	local s = new("Frame", { Name = "Sweep", BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.88, BorderSizePixel = 0,
		Size = UDim2.new(0, 50, 1, 0), Position = UDim2.new(0, -70, 0, 0), ZIndex = inst.ZIndex, Parent = inst },
		{ new("UIGradient", { Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }) }) })
	inst.ClipsDescendants = true
	inst.MouseEnter:Connect(function()
		s.Position = UDim2.new(0, -70, 0, 0)
		TweenService:Create(s, TweenInfo.new(0.6, Enum.EasingStyle.Sine), { Position = UDim2.new(1, 20, 0, 0) }):Play()
	end)
end
local function shadow(inst)
	new("ImageLabel", {
		Name = "Shadow", Image = "rbxassetid://6014261993", ImageColor3 = Color3.new(0, 0, 0), ImageTransparency = 0.45,
		ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(49, 49, 450, 450), BackgroundTransparency = 1,
		Size = UDim2.new(1, 50, 1, 50), Position = UDim2.fromOffset(-25, -20), ZIndex = inst.ZIndex - 1, Parent = inst.Parent,
	})
end

function Library:_bind(inst, prop, key)
	table.insert(self._themed, { inst, prop, key })
	inst[prop] = self.Theme[key]
	return inst
end
function Library:SetTheme(name)
	self.Theme = Themes[name] or Themes.Red
	self.ThemeName = name
	for _, t in ipairs(self._themed) do
		if t[1].Parent then t[1][t[2]] = self.Theme[t[3]] end
	end
	if self._themeLabel then self._themeLabel.Text = name end
	for _, fn in ipairs(self._onTheme) do fn(self.Theme) end
end
function Library:_conn(c) table.insert(self._conns, c); return c end
function Library:Destroy()
	for _, c in ipairs(self._conns) do c:Disconnect() end
	self._conns = {}
	if self.Gui then self.Gui:Destroy() end
end

function Library.new(opts)
	opts = opts or {}
	local self = setmetatable({ _themed = {}, _onTheme = {}, _conns = {}, Tabs = {}, Theme = Themes.Red, ThemeName = "Red" }, Library)

	local parentGui = (type(gethui) == "function" and gethui()) or player:WaitForChild("PlayerGui")
	local old = parentGui:FindFirstChild("ChickenHubUI")
	if old then old:Destroy() end
	local gui = new("ScreenGui", { Name = "ChickenHubUI", ResetOnSpawn = false, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling })
	gui.Parent = parentGui
	gui.Destroying:Connect(function() for _, c in ipairs(self._conns) do c:Disconnect() end end)
	self.Gui = gui

	local main = self:_bind(new("Frame", {
		Size = UDim2.fromOffset(620, 400), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 0.04, Parent = gui,
	}, { corner(14) }), "BackgroundColor3", "Bg")
	self:_bind(new("UIStroke", { Thickness = 1, Transparency = 0.15, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = main }), "Color", "Stroke")
	new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 150)), Parent = main })
	local holder = new("Frame", { BackgroundTransparency = 1, Size = main.Size, Position = main.Position, AnchorPoint = main.AnchorPoint, ZIndex = 0, Parent = gui })
	shadow(new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 1, Parent = holder }))
	main:GetPropertyChangedSignal("Position"):Connect(function() holder.Position = main.Position end)
	main:GetPropertyChangedSignal("Size"):Connect(function() holder.Size = main.Size end)
	main:GetPropertyChangedSignal("Visible"):Connect(function() holder.Visible = main.Visible end)
	main.ZIndex = 2
	self.Main = main

	new("Frame", { Name = "WindowShine", BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.93, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 120), Parent = main },
		{ corner(14), new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0, 1) }) })
	local edge = self:_bind(new("Frame", { Name = "AccentEdge", BorderSizePixel = 0, Size = UDim2.new(1, -40, 0, 2), Position = UDim2.fromOffset(20, 0), Parent = main }), "BackgroundColor3", "Accent")
	new("UIGradient", { Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.1), NumberSequenceKeypoint.new(1, 1) }), Parent = edge })

	local top = new("Frame", { Size = UDim2.new(1, 0, 0, 46), BackgroundTransparency = 1, Parent = main })
	new("Frame", { Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Color3.new(1,1,1), BackgroundTransparency = 0.92, BorderSizePixel = 0, Parent = top })
	local titleBox = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -140, 1, 0), Position = UDim2.fromOffset(16, 0), Parent = top },
		{ new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }) })
	new("TextLabel", {
		Text = opts.Title or "Chicken", Font = FONT_B, TextSize = 15, TextColor3 = TEXT, BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 46), LayoutOrder = 1, Parent = titleBox,
	})
	local crumb = self:_bind(new("TextLabel", {
		Text = "", Font = FONT_B, TextSize = 12, TextColor3 = TEXT, BackgroundTransparency = 0.2,
		AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 26), LayoutOrder = 2, Parent = titleBox,
	}, { corner(13), new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }) }), "BackgroundColor3", "Item")
	gloss(crumb)
	self:_bind(new("UIStroke", { Transparency = 0.4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = crumb }), "Color", "Accent")
	self._crumb, self._version = crumb, opts.Version

	local function topBtn(txt, idx, cb)
		local b = self:_bind(new("TextButton", {
			Text = txt, Font = FONT_B, TextSize = 16, TextColor3 = TEXT, AutoButtonColor = false,
			Size = UDim2.fromOffset(30, 30), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12 - (idx - 1) * 36, 0.5, 0), Parent = top,
		}, { corner(8) }), "BackgroundColor3", "Item")
		gloss(b)
		self:_bind(new("UIStroke", { Transparency = 0.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = b }), "Color", "Stroke")
		b.MouseEnter:Connect(function() tween(b, 0.15, { TextColor3 = self.Theme.Accent }) end)
		b.MouseLeave:Connect(function() tween(b, 0.15, { TextColor3 = TEXT }) end)
		b.MouseButton1Click:Connect(cb)
		return b
	end
	topBtn("X", 1, function() self:Destroy() end)
	local minimized = false
	local minimizeButton
	minimizeButton = topBtn("-", 2, function()
		minimized = not minimized
		minimizeButton.Text = minimized and "+" or "-"
		if self._side then self._side.Visible = not minimized end
		if self._content then self._content.Visible = not minimized end
		tween(main, 0.3, { Size = minimized and UDim2.fromOffset(620, 46) or UDim2.fromOffset(620, 400) })
	end)
	topBtn("~", 3, function() self:NextTheme() end)
	main.ClipsDescendants = true

	do
		local dragging, start, startPos
		top.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				dragging, start, startPos = true, i.Position, main.Position
				i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then dragging = false end end)
			end
		end)
		self:_conn(UserInputService.InputChanged:Connect(function(i)
			if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
				local d = i.Position - start
				main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end))
		self:_conn(UserInputService.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
		end))
	end
	self:_conn(UserInputService.InputBegan:Connect(function(i, gp)
		if not gp and i.KeyCode == (opts.ToggleKey or Enum.KeyCode.RightControl) then main.Visible = not main.Visible end
	end))

	local side = new("Frame", { Size = UDim2.new(0, 170, 1, -47), Position = UDim2.fromOffset(0, 47), BackgroundTransparency = 1, Parent = main })
	new("Frame", { Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(1, 0, 0, 0), BackgroundColor3 = Color3.new(1,1,1), BackgroundTransparency = 0.92, BorderSizePixel = 0, Parent = side })
	local search = self:_bind(new("TextBox", {
		PlaceholderText = "Search...", Text = "", Font = FONT, TextSize = 12, TextColor3 = TEXT, PlaceholderColor3 = SUBTEXT,
		TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
		Size = UDim2.new(1, -24, 0, 32), Position = UDim2.fromOffset(12, 10), Parent = side,
	}, { corner(8), new("UIPadding", { PaddingLeft = UDim.new(0, 10) }) }), "BackgroundColor3", "Panel")
	local searchStroke = self:_bind(new("UIStroke", { Transparency = 0.4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = search }), "Color", "Stroke")
	gloss(search, 0.6)
	search.Focused:Connect(function() searchStroke.Color = self.Theme.Accent end)
	search.FocusLost:Connect(function() searchStroke.Color = self.Theme.Stroke end)

	local tabList = new("ScrollingFrame", {
		Size = UDim2.new(1, -16, 1, -100), Position = UDim2.fromOffset(8, 52), BackgroundTransparency = 1,
		ScrollBarThickness = 0, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = side,
	}, { new("UIListLayout", { Padding = UDim.new(0, 4) }) })

	new("TextLabel", { Text = "Theme", Font = FONT, TextSize = 11, TextColor3 = SUBTEXT, BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.fromOffset(60, 24), Position = UDim2.new(0, 12, 1, -34), Parent = side })
	local themeLbl = self:_bind(new("TextButton", { Text = "Red", Font = FONT_B, TextSize = 11, AutoButtonColor = false,
		Size = UDim2.fromOffset(80, 22), Position = UDim2.new(1, -92, 1, -33), Parent = side }, { corner(6) }), "BackgroundColor3", "Item")
	self:_bind(themeLbl, "TextColor3", "Accent")
	self._themeLabel = themeLbl
	gloss(themeLbl)
	self:_bind(new("UIStroke", { Transparency = 0.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = themeLbl }), "Color", "Accent")
	themeLbl.MouseButton1Click:Connect(function() self:NextTheme() end)

	local content = new("Frame", { Size = UDim2.new(1, -182, 1, -57), Position = UDim2.fromOffset(176, 52), BackgroundTransparency = 1, Parent = main })

	self._tabList, self._content, self._search = tabList, content, search
	self._side = side
	search:GetPropertyChangedSignal("Text"):Connect(function() self:_filter(search.Text:lower()) end)
	return self
end

-- Cycle order now includes the two custom themes
local THEME_ORDER = { "Red", "Chicken", "Blue", "Green", "GirlChicken", "Purple" }
function Library:NextTheme()
	self:SetTheme(THEME_ORDER[(table.find(THEME_ORDER, self.ThemeName) or 1) % #THEME_ORDER + 1])
end

function Library:_filter(q)
	local firstHit
	for _, tab in ipairs(self.Tabs) do
		for _, item in ipairs(tab._items) do
			local hit = q == "" or item.Name:lower():find(q, 1, true) ~= nil
			item.Frame.Visible = hit
			if hit and q ~= "" and not firstHit then firstHit = tab end
		end
	end
	if firstHit and self.Current ~= firstHit then
		local any = false
		for _, item in ipairs(self.Current._items) do if item.Frame.Visible then any = true break end end
		if not any then self:_select(firstHit) end
	end
end

function Library:_select(tab)
	for _, t in ipairs(self.Tabs) do
		local on = t == tab
		t.Page.Visible = on
		tween(t.Button, 0.2, { BackgroundTransparency = on and 0.15 or 1 })
		t.Bar.Visible = on
		t.Stroke.Enabled = on
		t.Button.Shine.Visible = on
		t.Button.Rim.Visible = on
	end
	self._crumb.Text = tab.Name .. (tab._sub and tab._sub.Name and ("  >  " .. tab._sub.Name) or "") .. (self._version and ("   " .. self._version) or "")
	self.Current = tab
end

-- Tag outline icon
local function tagIcon(lib, parent)
	local holder = new("Frame", { Name = "TagIcon", BackgroundTransparency = 1,
		Size = UDim2.fromOffset(18, 18), Position = UDim2.new(0, 14, 0.5, -9), Parent = parent })
	local points = { Vector2.new(3, 3), Vector2.new(10, 3), Vector2.new(21, 14),
		Vector2.new(14, 21), Vector2.new(3, 10), Vector2.new(3, 3) }
	for i = 1, #points - 1 do
		local a, b = points[i] * 0.75, points[i + 1] * 0.75
		local delta, mid = b - a, (a + b) / 2
		lib:_bind(new("Frame", { BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(mid.X, mid.Y), Size = UDim2.fromOffset(delta.Magnitude + 1, 1.5),
			Rotation = math.deg(math.atan2(delta.Y, delta.X)), Parent = holder }, { corner(1) }), "BackgroundColor3", "Accent")
	end
	lib:_bind(new("Frame", { BorderSizePixel = 0, Size = UDim2.fromOffset(2, 2),
		Position = UDim2.fromOffset(4.5, 4.5), Parent = holder }, { corner(2) }), "BackgroundColor3", "Accent")
end

function Library:AddTab(name, icon)
	local tab = { Name = name, _items = {}, _subs = {}, _pillBar = nil, _sub = nil }
	local btn = self:_bind(new("TextButton", {
		Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), Parent = self._tabList,
	}, { corner(8) }), "BackgroundColor3", "Item")
	tab.Stroke = self:_bind(new("UIStroke", { Transparency = 0.35, Enabled = false, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = btn }), "Color", "Accent")
	gloss(btn)
	btn.MouseEnter:Connect(function() if self.Current ~= tab then tween(btn, 0.15, { BackgroundTransparency = 0.7 }) end end)
	btn.MouseLeave:Connect(function() if self.Current ~= tab then tween(btn, 0.15, { BackgroundTransparency = 1 }) end end)
	tab.Bar = self:_bind(new("Frame", { Size = UDim2.fromOffset(3, 18), Position = UDim2.new(0, 4, 0.5, -9), BorderSizePixel = 0, Visible = false, Parent = btn }, { corner(2) }), "BackgroundColor3", "Accent")
	if icon == "tag" then tagIcon(self, btn) end
	new("TextLabel", { Text = (icon and icon ~= "tag" and (icon .. "   ") or "") .. name, Font = FONT, TextSize = 13, TextColor3 = TEXT, BackgroundTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, icon == "tag" and -44 or -20, 1, 0), Position = UDim2.fromOffset(icon == "tag" and 42 or 16, 0), Parent = btn })
	tab.Button = btn

	local page = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = self._content })
	tab.Page = page
	tab._body = new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ScrollBarThickness = 3, ScrollBarImageTransparency = 0.5,
		AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = page,
	}, { new("UIListLayout", { Padding = UDim.new(0, 8) }), new("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }) })

	btn.MouseButton1Click:Connect(function() self:_select(tab) end)
	table.insert(self.Tabs, tab)
	if #self.Tabs == 1 then self:_select(tab) end

	local lib = self

	function tab:AddSubTab(subName)
		if not tab._pillBar then
			tab._pillBar = lib:_bind(new("ScrollingFrame", {
				Size = UDim2.new(1, -6, 0, 44), BackgroundTransparency = 0.2, ScrollBarThickness = 0,
				AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.X, Parent = page,
			}, { corner(10), new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Center }),
				new("UIPadding", { PaddingLeft = UDim.new(0, 8) }) }), "BackgroundColor3", "Panel")
			lib:_bind(new("UIStroke", { Transparency = 0.4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = tab._pillBar }), "Color", "Stroke")
			new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170)), Parent = tab._pillBar })
			if tab._body then tab._body:Destroy() end
			tab._body = nil
		end
		local sub = { Name = subName }
		local pill = new("TextButton", { Text = subName, Font = FONT_B, TextSize = 12, TextColor3 = SUBTEXT, AutoButtonColor = false,
			BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 30), Parent = tab._pillBar },
			{ corner(8), new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }) })
		lib:_bind(pill, "BackgroundColor3", "Accent")
		gloss(pill, 1.5)
		sub.Glow = lib:_bind(new("UIStroke", { Thickness = 2, Transparency = 0.6, Enabled = false, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = pill }), "Color", "Accent")
		pill.MouseEnter:Connect(function() if tab._sub ~= sub then tween(pill, 0.15, { TextColor3 = TEXT }) end end)
		pill.MouseLeave:Connect(function() if tab._sub ~= sub then tween(pill, 0.15, { TextColor3 = SUBTEXT }) end end)
		sub.Body = new("ScrollingFrame", {
			Size = UDim2.new(1, 0, 1, -52), Position = UDim2.fromOffset(0, 52), BackgroundTransparency = 1, ScrollBarThickness = 3,
			AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Visible = false, Parent = page,
		}, { new("UIListLayout", { Padding = UDim.new(0, 8) }), new("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }) })
		local function pick()
			for _, s in ipairs(tab._subs) do
				local on = s == sub
				s.Body.Visible = on
				s.Pill.Shine.Visible = on
				s.Pill.Rim.Visible = on
				s.Glow.Enabled = on
				tween(s.Pill, 0.2, { BackgroundTransparency = on and 0 or 1, TextColor3 = on and TEXT or SUBTEXT })
			end
			tab._sub = sub
			if lib.Current == tab then lib:_select(tab) end
		end
		sub.Pill = pill
		pill.MouseButton1Click:Connect(pick)
		table.insert(tab._subs, sub)
		if #tab._subs == 1 then pick() end
		function sub:AddSection(n) return lib:_section(tab, sub.Body, n) end
		return sub
	end
	function tab:AddSection(n)
		local body = tab._body or (tab._subs[1] and tab._subs[1].Body)
		return lib:_section(tab, body, n)
	end
	return tab
end

function Library:_section(tab, parent, name)
	local lib = self
	local sec = {}
	local frame = self:_bind(new("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 0.1, ClipsDescendants = true, Parent = parent }, { corner(12) }), "BackgroundColor3", "Panel")
	self:_bind(new("UIStroke", { Transparency = 0.4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = frame }), "Color", "Stroke")
	new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(185, 185, 185)), Parent = frame })
	local header = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), Parent = frame })
	local dot = self:_bind(new("Frame", { Size = UDim2.fromOffset(8, 8), Position = UDim2.new(0, 16, 0.5, -4), Parent = header }, { corner(4) }), "BackgroundColor3", "Accent")
	self:_bind(new("UIStroke", { Thickness = 3, Transparency = 0.7, Parent = dot }), "Color", "Accent")
	new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.94, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 44), Parent = frame },
		{ corner(12), new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0, 1) }) })
	new("Frame", { Name = "Rim", BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.8, BorderSizePixel = 0,
		Size = UDim2.new(1, -24, 0, 1), Position = UDim2.fromOffset(12, 1), Parent = frame },
		{ new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }) }) })
	header.ZIndex = 2
	new("TextLabel", { Text = name, Font = FONT_B, TextSize = 14, TextColor3 = TEXT, BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -60, 1, 0), Position = UDim2.fromOffset(32, 0), Parent = header })
	local arrow = new("TextLabel", { Text = ">", Font = FONT_B, TextSize = 18, TextColor3 = TEXT, BackgroundTransparency = 1,
		Size = UDim2.fromOffset(20, 44), Position = UDim2.new(1, -32, 0, 0), Rotation = 90, Parent = header })
	local list = new("Frame", { Size = UDim2.new(1, 0, 0, 0), Position = UDim2.fromOffset(0, 46), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = frame },
		{ new("UIListLayout", { Padding = UDim.new(0, 6) }), new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }) })

	local open = true
	local function resize(animate)
		local h = open and (46 + list.AbsoluteSize.Y) or 44
		if animate then tween(frame, 0.25, { Size = UDim2.new(1, 0, 0, h) }) else frame.Size = UDim2.new(1, 0, 0, h) end
		tween(arrow, 0.25, { Rotation = open and 90 or 0 })
	end
	list:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() if open then resize(false) end end)
	header.MouseButton1Click:Connect(function() open = not open; resize(true) end)
	function sec:SetOpen(v) open = v; resize(false) end

	local function row(rightWidth, itemName, desc)
		rightWidth = rightWidth or 70
		local r = lib:_bind(new("Frame", { Size = UDim2.new(1, 0, 0, desc and 52 or 42), BackgroundTransparency = 0.25, Parent = list }, { corner(10) }), "BackgroundColor3", "Item")
		gloss(r, 1.1)
		sweep(r)
		lib:_bind(new("UIStroke", { Transparency = 0.6, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = r }), "Color", "Stroke")
		r.MouseEnter:Connect(function() tween(r, 0.15, { BackgroundTransparency = 0.05 }) end)
		r.MouseLeave:Connect(function() tween(r, 0.15, { BackgroundTransparency = 0.25 }) end)
		if itemName then
			new("TextLabel", { Text = itemName, Font = FONT_B, TextSize = 13, TextColor3 = TEXT, BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, -(rightWidth + 24), 0, 18), Position = UDim2.new(0, 12, 0, desc and 8 or 12), Parent = r })
			if desc then
				new("TextLabel", { Text = desc, Font = FONT, TextSize = 11, TextColor3 = SUBTEXT, BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.new(1, -(rightWidth + 24), 0, 14), Position = UDim2.fromOffset(12, 28), Parent = r })
			end
			table.insert(tab._items, { Name = itemName, Frame = r })
		end
		return r
	end

	function sec:AddLabel(text)
		local f = new("Frame", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Parent = list })
		for _, x in ipairs({ 0, 1 }) do
			new("Frame", { Size = UDim2.new(0.5, -50, 0, 1), AnchorPoint = Vector2.new(x, 0.5), Position = UDim2.new(x, 0, 0.5, 0),
				BackgroundColor3 = Color3.new(1,1,1), BackgroundTransparency = 0.9, BorderSizePixel = 0, Parent = f })
		end
		lib:_bind(new("TextLabel", { Text = "- [ " .. text .. " ] -", Font = FONT_B, TextSize = 11, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = f }), "TextColor3", "Accent")
	end

	function sec:AddText(text)
		local r = row(10)
		local lbl = new("TextLabel", { Text = text, Font = FONT, TextSize = 12, TextColor3 = SUBTEXT, BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true, Size = UDim2.new(1, -24, 1, -8), Position = UDim2.fromOffset(12, 4), Parent = r })
		return { Set = function(_, t) lbl.Text = t end }
	end

	function sec:AddToggle(o)
		local OFF = Color3.fromRGB(48, 46, 50)
		local r = row(60, o.Name, o.Description)
		local sw = new("Frame", { Size = UDim2.fromOffset(46, 24), AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0), BackgroundColor3 = OFF, ZIndex = 2, Parent = r }, { corner(12) })
		local swGlow = lib:_bind(new("UIStroke", { Thickness = 2, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = sw }), "Color", "Accent")
		gloss(sw, 1.6)
		local knob = new("Frame", { Size = UDim2.fromOffset(18, 18), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = Color3.new(1,1,1), ZIndex = 3, Parent = sw }, { corner(9) })
		new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(195, 195, 195)), Parent = knob })
		new("UIStroke", { Color = Color3.new(0, 0, 0), Transparency = 0.7, Parent = knob })
		local hit = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = r })
		local state = false
		local api = {}
		local function paint()
			tween(knob, 0.2, { Position = UDim2.fromOffset(state and 25 or 3, 3) })
			tween(sw, 0.2, { BackgroundColor3 = state and lib.Theme.Accent or OFF })
			tween(swGlow, 0.2, { Transparency = state and 0.55 or 1 })
		end
		function api:Set(v, silent)
			v = v and true or false
			if v == state then return end
			state = v
			paint()
			if o.Callback and not silent then task.spawn(o.Callback, v) end
		end
		function api:Get() return state end
		hit.MouseButton1Click:Connect(function() api:Set(not state) end)
		table.insert(lib._onTheme, function() if state then sw.BackgroundColor3 = lib.Theme.Accent end end)
		if o.Default then api:Set(true, true) end
		return api
	end

	function sec:AddSlider(o)
		local min, max = o.Min or 0, o.Max or 100
		local step = o.Step or 1
		local r = row(250, o.Name, o.Description)
		local box = lib:_bind(new("TextBox", { Text = tostring(o.Default or min), Font = FONT_B, TextSize = 13, TextColor3 = TEXT, ClearTextOnFocus = false,
			Size = UDim2.fromOffset(56, 30), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), ZIndex = 2, Parent = r }, { corner(7) }), "BackgroundColor3", "Bg")
		lib:_bind(new("UIStroke", { Transparency = 0.2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = box }), "Color", "Accent")
		gloss(box, 0.8)
		local bar = new("Frame", { Size = UDim2.fromOffset(150, 6), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -82, 0.5, 0),
			BackgroundColor3 = Color3.fromRGB(8, 8, 10), ZIndex = 2, Parent = r }, { corner(3) })
		local hitbox = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 16, 0, 26), Position = UDim2.new(0, -8, 0.5, -13), ZIndex = 5, Parent = bar })
		local fill = lib:_bind(new("Frame", { Size = UDim2.fromScale(0, 1), ZIndex = 3, Parent = bar }, { corner(3) }), "BackgroundColor3", "Accent")
		new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170)), Parent = fill })
		local knob = new("Frame", { Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = Color3.new(1,1,1), ZIndex = 4, Parent = bar }, { corner(8) })
		new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(195, 195, 195)), Parent = knob })
		lib:_bind(new("UIStroke", { Thickness = 3, Transparency = 0.6, Parent = knob }), "Color", "Accent")
		local api, value = {}, nil
		function api:Set(v, silent)
			v = tonumber(v) or value or min
			v = math.clamp(math.floor((v - min) / step + 0.5) * step + min, min, max)
			local a = (max > min) and (v - min) / (max - min) or 0
			fill.Size = UDim2.fromScale(a, 1); knob.Position = UDim2.fromScale(a, 0.5); box.Text = tostring(v)
			if v == value then return end
			value = v
			if o.Callback and not silent then task.spawn(o.Callback, v) end
		end
		function api:Get() return value end
		local dragging = false
		local function update(x) api:Set(min + (max - min) * math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)) end
		hitbox.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				dragging = true; update(i.Position.X)
				tween(knob, 0.15, { Size = UDim2.fromOffset(20, 20) })
			end
		end)
		lib:_conn(UserInputService.InputChanged:Connect(function(i)
			if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then update(i.Position.X) end
		end))
		lib:_conn(UserInputService.InputEnded:Connect(function(i)
			if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
				dragging = false
				tween(knob, 0.15, { Size = UDim2.fromOffset(16, 16) })
			end
		end))
		box.FocusLost:Connect(function() api:Set(box.Text) end)
		api:Set(o.Default or min, true)
		return api
	end

	function sec:AddButton(o)
		local r = row(40, o.Name, o.Description)
		local chip = lib:_bind(new("TextLabel", { Text = ">", Font = FONT_B, TextSize = 18, TextColor3 = TEXT, Size = UDim2.fromOffset(28, 28),
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), ZIndex = 2, Parent = r }, { corner(8) }), "BackgroundColor3", "Accent")
		gloss(chip, 1.5)
		local b = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = r })
		b.MouseButton1Click:Connect(function()
			tween(r, 0.08, { BackgroundTransparency = 0 }); task.delay(0.1, function() tween(r, 0.25, { BackgroundTransparency = 0.25 }) end)
			if o.Callback then task.spawn(o.Callback) end
		end)
	end

	function sec:AddDropdown(o)
		local items, current = o.Options or {}, o.Default
		local r = row(150, o.Name, o.Description)
		local baseH = r.Size.Y.Offset
		local btn = lib:_bind(new("TextButton", { Text = tostring(current or "Select...") .. "  v", Font = FONT_B, TextSize = 12, TextColor3 = TEXT, AutoButtonColor = false,
			TextTruncate = Enum.TextTruncate.AtEnd, Size = UDim2.fromOffset(140, 28), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, (baseH - 28) / 2), ZIndex = 6, Parent = r },
			{ corner(7) }), "BackgroundColor3", "Bg")
		lib:_bind(new("UIStroke", { Transparency = 0.4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = btn }), "Color", "Accent")
		gloss(btn, 0.8)
		local menu = lib:_bind(new("ScrollingFrame", { Visible = false, Size = UDim2.new(1, -20, 0, 0), Position = UDim2.fromOffset(10, baseH),
			ScrollBarThickness = 2, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ZIndex = 20, Parent = r },
			{ corner(8), new("UIListLayout", { Padding = UDim.new(0, 2) }), new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }) }), "BackgroundColor3", "Panel")
		lib:_bind(new("UIStroke", { Transparency = 0.3, Parent = menu }), "Color", "Stroke")
		local api = {}
		local function menuH() return math.min(#items, 5) * 28 + 8 end
		local function setOpen(v)
			menu.Visible = v
			menu.Size = UDim2.new(1, -20, 0, menuH())
			tween(r, 0.2, { Size = UDim2.new(1, 0, 0, v and (baseH + menuH() + 8) or baseH) })
		end
		function api:Set(v, silent)
			current = v; btn.Text = tostring(v) .. "  v"; setOpen(false)
			if o.Callback and not silent then task.spawn(o.Callback, v) end
		end
		function api:Get() return current end
		function api:Refresh(newItems)
			items = newItems
			for _, c in ipairs(menu:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
			for _, it in ipairs(items) do
				local ob = lib:_bind(new("TextButton", { Text = tostring(it), Font = FONT, TextSize = 12, TextColor3 = TEXT, AutoButtonColor = false,
					BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 26), ZIndex = 21, Parent = menu }, { corner(6) }), "BackgroundColor3", "Accent")
				ob.MouseEnter:Connect(function() tween(ob, 0.1, { BackgroundTransparency = 0.5 }) end)
				ob.MouseLeave:Connect(function() tween(ob, 0.1, { BackgroundTransparency = 1 }) end)
				ob.MouseButton1Click:Connect(function() api:Set(it) end)
			end
			if menu.Visible then setOpen(true) end
		end
		btn.MouseButton1Click:Connect(function() setOpen(not menu.Visible) end)
		api:Refresh(items)
		return api
	end

	function sec:AddTextInput(o)
		local items = o.Options or {}
		local r = row(160, o.Name, o.Description)
		local baseH = r.Size.Y.Offset
		local box = lib:_bind(new("TextBox", {
			PlaceholderText = o.Placeholder or "type...", Text = o.Default or "",
			Font = FONT, TextSize = 12, TextColor3 = TEXT, PlaceholderColor3 = SUBTEXT,
			TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
			Size = UDim2.fromOffset(148, 28), AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0), ZIndex = 6, Parent = r,
		}, { corner(7), new("UIPadding", { PaddingLeft = UDim.new(0, 6) }) }), "BackgroundColor3", "Bg")
		lib:_bind(new("UIStroke", { Transparency = 0.4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = box }), "Color", "Accent")
		gloss(box, 0.8)
		local menu = lib:_bind(new("ScrollingFrame", {
			Visible = false, Size = UDim2.new(1, -20, 0, 0), Position = UDim2.fromOffset(10, baseH),
			ScrollBarThickness = 2, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ZIndex = 20, Parent = r,
		}, { corner(8), new("UIListLayout", { Padding = UDim.new(0, 2) }),
			new("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }) }), "BackgroundColor3", "Panel")
		lib:_bind(new("UIStroke", { Transparency = 0.3, Parent = menu }), "Color", "Stroke")
		local function mH(n) return math.min(n, 5) * 28 + 8 end
		local function showAC(filtered)
			for _, c in ipairs(menu:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
			for _, it in ipairs(filtered) do
				local ob = lib:_bind(new("TextButton", {
					Text = tostring(it), Font = FONT, TextSize = 12, TextColor3 = TEXT, AutoButtonColor = false,
					BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 26), ZIndex = 21, Parent = menu,
				}, { corner(6) }), "BackgroundColor3", "Accent")
				ob.MouseEnter:Connect(function() tween(ob, 0.1, { BackgroundTransparency = 0.5 }) end)
				ob.MouseLeave:Connect(function() tween(ob, 0.1, { BackgroundTransparency = 1 }) end)
				ob.MouseButton1Click:Connect(function()
					box.Text = it; menu.Visible = false
					tween(r, 0.2, { Size = UDim2.new(1, 0, 0, baseH) })
					if o.Callback then task.spawn(o.Callback, it) end
				end)
			end
			if #filtered > 0 then
				menu.Visible = true; menu.Size = UDim2.new(1, -20, 0, mH(#filtered))
				tween(r, 0.2, { Size = UDim2.new(1, 0, 0, baseH + mH(#filtered) + 8) })
			else
				menu.Visible = false; tween(r, 0.2, { Size = UDim2.new(1, 0, 0, baseH) })
			end
		end
		box:GetPropertyChangedSignal("Text"):Connect(function()
			local q = box.Text:lower()
			if o.Callback then task.spawn(o.Callback, box.Text) end
			if q == "" or #items == 0 then menu.Visible = false; tween(r, 0.2, { Size = UDim2.new(1, 0, 0, baseH) }); return end
			local matches = {}
			for _, it in ipairs(items) do
				if tostring(it):lower():find(q, 1, true) then table.insert(matches, it); if #matches >= 5 then break end end
			end
			showAC(matches)
		end)
		local api = {}
		function api:Get() return box.Text end
		function api:Set(v) box.Text = tostring(v or "") end
		return api
	end

	return sec
end

return Library
