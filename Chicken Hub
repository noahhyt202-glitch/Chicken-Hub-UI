	return self
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Tab selection & filtering
-- ─────────────────────────────────────────────────────────────────────────────

function Library:_select(tab)
	for _, t in ipairs(self.Tabs) do
		local on = t == tab
		t.Page.Visible = on
		tween(t.Button, 0.22, { BackgroundTransparency = on and 0.08 or 1 })
		t.Bar.Visible    = on
		t.Stroke.Enabled = on
		t.Button.Shine.Visible = on
		t.Button.Rim.Visible   = on
		local lbl = t.Button:FindFirstChildOfClass("TextLabel")
		if lbl then
			tween(lbl, 0.22, { TextColor3 = on and self.Theme.Accent or TEXT })
		end
	end
	self._crumb.Text = tab.Name
		.. (tab._sub and tab._sub.Name and ("  ›  " .. tab._sub.Name) or "")
		.. (self._version and ("   " .. self._version) or "")
	self.Current = tab
end

function Library:_filter(q)
	local firstHit
	for _, tab in ipairs(self.Tabs) do
		for _, item in ipairs(tab._items) do
			local hit = q == "" or item.Name:lower():find(q,1,true) ~= nil
			item.Frame.Visible = hit
			if hit and q ~= "" and not firstHit then firstHit = tab end
		end
	end
	if firstHit and self.Current ~= firstHit then
		local any = false
		for _, item in ipairs(self.Current._items) do
			if item.Frame.Visible then any = true; break end
		end
		if not any then self:_select(firstHit) end
	end
end

