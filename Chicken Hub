local Library = {}
Library.__index = Library

function Library:_bind(inst, prop, key)
	table.insert(self._themed, { inst, prop, key })
	inst[prop] = self.Theme[key]
	return inst
end

function Library:SetTheme(name)
	self.Theme     = Themes[name] or Themes.Red
	self.ThemeName = name
	for _, t in ipairs(self._themed) do
		if t[1].Parent then t[1][t[2]] = self.Theme[t[3]] end
	end
	if self._themeLabel then self._themeLabel.Text = name end
	for _, fn in ipairs(self._onTheme) do fn(self.Theme) end
end

function Library:NextTheme()
	self:SetTheme(THEME_ORDER[
		(table.find(THEME_ORDER, self.ThemeName) or 1) % #THEME_ORDER + 1])
end

function Library:_conn(c) table.insert(self._conns, c); return c end

function Library:Destroy()
	for _, c in ipairs(self._conns) do c:Disconnect() end
	self._conns = {}
	if self.Gui then self.Gui:Destroy() end
end

-- ─────────────────────────────── Config system ───────────────────────────────

function Library:SetConfig(name)
	self._configFile = name
	local ok, raw = pcall(readfile, name .. "_config.json")
	if ok and raw and #raw > 0 then
		local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw)
		if ok2 and type(data) == "table" then
			self._configData = data
			for key, api in pairs(self._config) do
				if data[key] ~= nil then pcall(api.Set, api, data[key], true) end
			end
		end
	end
	return self
end

function Library:SaveConfig()
	if not self._configFile then return end
	local data = {}
	for key, api in pairs(self._config) do data[key] = api:Get() end
	local ok, json = pcall(HttpService.JSONEncode, HttpService, data)
	if ok then pcall(writefile, self._configFile .. "_config.json", json) end
end

function Library:_regCfg(key, api)
	if not key then return end
	self._config[key] = api
	if self._configData[key] ~= nil then
		pcall(api.Set, api, self._configData[key], true)
	end
	local lib = self
	local orig = api.Set
	api.Set = function(s, v, silent)
		orig(s, v, silent)
		if not silent then lib:SaveConfig() end
	end
end

