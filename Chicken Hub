	closeBtn.MouseLeave:Connect(function() closeBtn.TextColor3 = SUBTEXT end)

	-- Message
	new("TextLabel", {
		Text = t.Message, Font = FONT, TextSize = 12, TextColor3 = SUBTEXT,
		BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Size = UDim2.fromOffset(258, 32), Position = UDim2.fromOffset(16, 28),
		ZIndex = 101, Parent = toast,
	})

	-- Border tinted to type colour
	new("UIStroke", {
		Color = color, Transparency = 0.55,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = toast,
	})

	-- Progress bar at the bottom
	local progBg = new("Frame", {
		BackgroundColor3 = Color3.new(0,0,0), BackgroundTransparency = 0.7,
		BorderSizePixel = 0,
		Size = UDim2.new(1,0,0,3), Position = UDim2.new(0,0,1,-3),
		ZIndex = 101, Parent = toast,
	})
	local prog = new("Frame", {
		BackgroundColor3 = color, BorderSizePixel = 0,
		Size = UDim2.fromScale(1,1), ZIndex = 102, Parent = progBg,
	}, { corner(2) })

	-- Slide in
