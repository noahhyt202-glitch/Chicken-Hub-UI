	Features:
	 • Larger, prominent title  •  Taller search bar + magnifier icon
	 • Strong selected-tab highlight  •  Smooth hover animations
	 • Proper "▶ Run" spawn button  •  Taller text-input boxes
	 • Diagonal gradient + accent-glow background
	 • Panels darker than window background
	 • Pop-in loading animation
	 • Config save / load system  (writefile / readfile)
	 • Toast notification system  (Notify, WatchRemote)
	 • Built-in Dashboard tab builder
	 • Built-in Notifications tab builder

	Quick start:
		local Lib = ChickenUI.new({ Title = "My Hub", Version = "v1.0" })
		Lib:SetConfig("MyHub")

		Lib:AddDashboardTab()          -- hub/player/game info
		Lib:AddNotificationsTab()      -- live notification log

		local tab = Lib:AddTab("Combat", "tag")
		local sec = tab:AddSection("Settings")
		sec:AddToggle({ Name = "Aimbot", Key = "aimbot", Default = false,
		                Callback = function(v) end })
		sec:AddButton({ Name = "Teleport", Callback = function() end })

		-- Watch a remote; notifies if it goes offline or errors
		Lib:WatchRemote(workspace:WaitForChild("SomeRemote"), "SomeRemote")

		-- Manual notification
		Lib:Notify({ Title = "Ready", Message = "Hub loaded!", Type = "success" })
]]

