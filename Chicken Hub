function Library:_section(tab, parent, name)
	local lib = self
	local sec = {}

	local frame = self:_bind(new("Frame", {
		Size = UDim2.new(1,0,0,44), BackgroundTransparency = 0.1,
		ClipsDescendants = true, Parent = parent,
	}, {corner(12)}), "BackgroundColor3","Panel")
	self:_bind(new("UIStroke",{Transparency=0.35,ApplyStrokeMode=Enum.ApplyStrokeMode.Border,Parent=frame}),
		"Color","Stroke")
	new("UIGradient",{Rotation=90,Color=ColorSequence.new(Color3.new(1,1,1),Color3.fromRGB(185,185,185)),Parent=frame})

	local header = new("TextButton", {
		Text="", BackgroundTransparency=1, Size=UDim2.new(1,0,0,44), Parent=frame,
	})
	local dot = self:_bind(new("Frame",{
		Size=UDim2.fromOffset(8,8), Position=UDim2.new(0,16,0.5,-4), Parent=header,
	},{corner(4)}), "BackgroundColor3","Accent")
	self:_bind(new("UIStroke",{Thickness=3,Transparency=0.6,Parent=dot}), "Color","Accent")

	new("Frame",{
		BackgroundColor3=Color3.new(1,1,1), BackgroundTransparency=0.94, BorderSizePixel=0,
		Size=UDim2.new(1,0,0,44), Parent=frame,
	},{corner(12), new("UIGradient",{Rotation=90,Transparency=NumberSequence.new(0,1)})})
	new("Frame",{
		Name="Rim", BackgroundColor3=Color3.new(1,1,1), BackgroundTransparency=0.8,
		BorderSizePixel=0, Size=UDim2.new(1,-24,0,1), Position=UDim2.fromOffset(12,1), Parent=frame,
	},{new("UIGradient",{Transparency=NumberSequence.new({
		NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.5,0),NumberSequenceKeypoint.new(1,1)})})})

	header.ZIndex = 2
	new("TextLabel",{
		Text=name, Font=FONT_B, TextSize=14, TextColor3=TEXT, BackgroundTransparency=1,
		TextXAlignment=Enum.TextXAlignment.Left,
		Size=UDim2.new(1,-60,1,0), Position=UDim2.fromOffset(32,0), Parent=header,
	})
	local arrow = new("TextLabel",{
		Text="›", Font=FONT_B, TextSize=20, TextColor3=TEXT, BackgroundTransparency=1,
		Size=UDim2.fromOffset(20,44), Position=UDim2.new(1,-30,0,0),
		Rotation=90, Parent=header,
	})

	local list = new("Frame",{
		Size=UDim2.new(1,0,0,0), Position=UDim2.fromOffset(0,46),
		AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1, Parent=frame,
	},{new("UIListLayout",{Padding=UDim.new(0,6)}),
	   new("UIPadding",{PaddingLeft=UDim.new(0,8),PaddingRight=UDim.new(0,8),PaddingBottom=UDim.new(0,8)})})

	-- Expose internals for AddNotificationsTab
	sec._listFrame    = list
	sec._sectionFrame = frame

	local open = true
	local function resize(animate)
		local h = open and (46 + list.AbsoluteSize.Y) or 44
		if animate then tween(frame,0.25,{Size=UDim2.new(1,0,0,h)})
		else frame.Size = UDim2.new(1,0,0,h) end
		tween(arrow, 0.25, { Rotation = open and 90 or 0 })
	end
	list:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if open then resize(false) end
	end)
	header.MouseButton1Click:Connect(function() open = not open; resize(true) end)
	function sec:SetOpen(v) open = v; resize(false) end

	-- ── Row ──────────────────────────────────────────────────────────────────
	local function row(rightWidth, itemName, desc)
		rightWidth = rightWidth or 70
		local r = lib:_bind(new("Frame",{
			Size=UDim2.new(1,0,0,desc and 52 or 42),
			BackgroundTransparency=0.25, Parent=list,
		},{corner(10)}), "BackgroundColor3","Item")
		gloss(r,1.1); sweep(r)
		lib:_bind(new("UIStroke",{Transparency=0.6,ApplyStrokeMode=Enum.ApplyStrokeMode.Border,Parent=r}),
			"Color","Stroke")
		r.MouseEnter:Connect(function() tween(r,0.18,{BackgroundTransparency=0.05}) end)
		r.MouseLeave:Connect(function() tween(r,0.18,{BackgroundTransparency=0.25}) end)
		if itemName then
			new("TextLabel",{
				Text=itemName, Font=FONT_B, TextSize=13, TextColor3=TEXT,
				BackgroundTransparency=1, TextXAlignment=Enum.TextXAlignment.Left,
				TextTruncate=Enum.TextTruncate.AtEnd,
				Size=UDim2.new(1,-(rightWidth+24),0,18),
				Position=UDim2.new(0,12,0,desc and 8 or 12), Parent=r,
			})
			if desc then
				new("TextLabel",{
					Text=desc, Font=FONT, TextSize=11, TextColor3=SUBTEXT,
					BackgroundTransparency=1, TextXAlignment=Enum.TextXAlignment.Left,
					TextTruncate=Enum.TextTruncate.AtEnd,
					Size=UDim2.new(1,-(rightWidth+24),0,14),
					Position=UDim2.fromOffset(12,28), Parent=r,
				})
			end
			table.insert(tab._items, { Name=itemName, Frame=r })
		end
		return r
	end

	function sec:AddLabel(text)
		local f = new("Frame",{Size=UDim2.new(1,0,0,24),BackgroundTransparency=1,Parent=list})
		for _, x in ipairs({0,1}) do
			new("Frame",{Size=UDim2.new(0.5,-50,0,1), AnchorPoint=Vector2.new(x,0.5),
				Position=UDim2.new(x,0,0.5,0), BackgroundColor3=Color3.new(1,1,1),
				BackgroundTransparency=0.9, BorderSizePixel=0, Parent=f})
		end
		lib:_bind(new("TextLabel",{
			Text="─ [ "..text.." ] ─", Font=FONT_B, TextSize=11,
			BackgroundTransparency=1, Size=UDim2.fromScale(1,1), Parent=f,
		}), "TextColor3","Accent")
	end

	function sec:AddText(text)
		local r = row(10)
		local lbl = new("TextLabel",{
			Text=text, Font=FONT, TextSize=12, TextColor3=SUBTEXT,
			BackgroundTransparency=1, TextXAlignment=Enum.TextXAlignment.Left,
			TextWrapped=true, Size=UDim2.new(1,-24,1,-8), Position=UDim2.fromOffset(12,4),
			Parent=r,
		})
		return { Set = function(_, t) lbl.Text = t end }
	end

	function sec:AddToggle(o)
		local OFF = Color3.fromRGB(44,42,48)
		local r   = row(60, o.Name, o.Description)
		local sw  = new("Frame",{
