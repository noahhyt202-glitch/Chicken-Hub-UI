	-- Keep the window on screen when the viewport changes (phones, resizing)
	local animating = true
	local cam = workspace.CurrentCamera
	if cam then
		self:_conn(cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if not animating then uiScale.Scale = fitScale() end
		end))
	end

	-- Pop-in
	local target = fitScale()
	uiScale.Scale = target * 0.9
	root.Position = UDim2.new(0.5, 0, 0.5, 14)
	task.defer(function()
		tween(uiScale, 0.4, { Scale = target }, Enum.EasingStyle.Back)
		tween(root, 0.4, { Position = UDim2.fromScale(0.5, 0.5) })
		task.delay(0.15, function() tween(accentGlow, 0.6, { BackgroundTransparency = 0.84 }) end)
		task.delay(0.45, function() animating = false end)
	end)

	return self
end

-- ─────────────────────────────────────────────────────────────────────────────
-- Tab selection & filtering
-- ─────────────────────────────────────────────────────────────────────────────

function Library:_select(tab)
	local changed = self.Current ~= tab
	for _, t in ipairs(self.Tabs) do
		local on = t == tab
		t.Page.Visible = on
		tween(t.Button, 0.22, { BackgroundTransparency = on and 0.1 or 1 })
		t.Bar.Visible, t.Stroke.Enabled, t.Tint.Visible = on, on, on
		t.Shine.Visible, t.Rim.Visible = on, on
		t._tabLbl.Font = on and FONT_B or FONT
		tween(t._tabLbl, 0.22, { TextColor3 = on and self.Theme.Accent or TEXT })
	end
	if changed then
		tab.Page.Position = UDim2.fromOffset(0, 10)
		tween(tab.Page, 0.28, { Position = UDim2.fromOffset(0, 0) })
	end
	self._crumb.Text = tab.Name
		.. (tab._sub and tab._sub.Name and ("  ›  " .. tab._sub.Name) or "")
		.. (self._version and self._version ~= "" and ("   " .. self._version) or "")
	self.Current = tab
end

function Library:_filter(q)
	local firstHit
	for _, tab in ipairs(self.Tabs) do
		for _, item in ipairs(tab._items) do
			local hit = q == "" or item.Name:lower():find(q, 1, true) ~= nil
			item.Frame.Visible = hit
			if hit and q ~= "" and not firstHit then firstHit = tab end
		end
	end
	if firstHit and self.Current and self.Current ~= firstHit then
		for _, item in ipairs(self.Current._items) do
			if item.Frame.Visible then return end
		end
		self:_select(firstHit)
	end
end

