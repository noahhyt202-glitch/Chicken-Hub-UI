	function sec:AddToggle(o)
		local OFF = Color3.fromRGB(44, 42, 48)
		local r, hit = row(60, o.Name, o.Description, true)
		local sw = new("Frame", {
			Size = UDim2.fromOffset(46, 24), AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0), BackgroundColor3 = OFF, ZIndex = 2, Parent = r,
		}, { corner(12) })
		local swGlow = lib:_bind(new("UIStroke", { Thickness = 2, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = sw }),
			"Color", "Accent")
		gloss(sw, 1.6)
		local knob = new("Frame", {
			Size = UDim2.fromOffset(18, 18), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = WHITE, ZIndex = 3, Parent = sw,
		}, { corner(9) })
		new("UIGradient", { Rotation = 90, Color = ColorSequence.new(WHITE, Color3.fromRGB(195, 195, 195)), Parent = knob })
		new("UIStroke", { Color = BLACK, Transparency = 0.7, Parent = knob })
		local state, api = false, {}
		local function paint()
			tween(knob, 0.22, { Position = UDim2.fromOffset(state and 25 or 3, 3) }, Enum.EasingStyle.Back)
			tween(sw, 0.2, { BackgroundColor3 = state and lib.Theme.Accent or OFF })
			tween(swGlow, 0.2, { Transparency = state and 0.45 or 1 })
		end
		function api:Set(v, silent)
			v = v and true or false
			if v == state then return end
			state = v
			paint()
			if o.Callback and not silent then task.spawn(o.Callback, v) end
		end
		function api:Get() return state end
		api._fire = function() if o.Callback then task.spawn(o.Callback, state) end end
		hit.MouseButton1Click:Connect(function() api:Set(not state) end)
		table.insert(lib._onTheme, function(th) if state then sw.BackgroundColor3 = th.Accent end end)
		if o.Default then api:Set(true, true) end
		lib:_regCfg(o.Key, api)
		return api
	end

	function sec:AddSlider(o)
		local min, max = tonumber(o.Min) or 0, tonumber(o.Max) or 100
		local step = tonumber(o.Step) or 1
		if step <= 0 then step = 1 end
		local decimals = math.max(decimalsOf(step), decimalsOf(min))
		local function fmt(v)
			if decimals == 0 then return tostring(math.floor(v + 0.5)) end
			return string.format("%." .. decimals .. "f", v)
		end
		local r = row(250, o.Name, o.Description)
		local box = lib:_bind(new("TextBox", {
			Text = fmt(tonumber(o.Default) or min), Font = FONT_B, TextSize = 13, TextColor3 = TEXT, ClearTextOnFocus = false,
			Size = UDim2.fromOffset(56, 30), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), ZIndex = 2, Parent = r,
		}, { corner(7) }), "BackgroundColor3", "Bg")
		lib:_bind(new("UIStroke", { Transparency = 0.2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = box }), "Color", "Accent")
		gloss(box, 0.8)
		local bar = new("Frame", {
			Size = UDim2.fromOffset(150, 6), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -82, 0.5, 0),
			BackgroundColor3 = Color3.fromRGB(8, 8, 10), ZIndex = 2, Parent = r,
		}, { corner(3) })
		new("UIStroke", { Color = WHITE, Transparency = 0.9, Parent = bar })
		local hitbox = new("TextButton", {
			Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
			Size = UDim2.new(1, 16, 0, 26), Position = UDim2.new(0, -8, 0.5, -13), ZIndex = 5, Parent = bar,
		})
		local fill = lib:_bind(new("Frame", { Size = UDim2.fromScale(0, 1), ZIndex = 3, Parent = bar }, { corner(3) }), "BackgroundColor3", "Accent")
		new("UIGradient", { Rotation = 90, Color = ColorSequence.new(WHITE, Color3.fromRGB(160, 160, 160)), Parent = fill })
		local knob = new("Frame", {
			Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5),
			BackgroundColor3 = WHITE, ZIndex = 4, Parent = bar,
		}, { corner(8) })
		new("UIGradient", { Rotation = 90, Color = ColorSequence.new(WHITE, Color3.fromRGB(195, 195, 195)), Parent = knob })
		lib:_bind(new("UIStroke", { Thickness = 3, Transparency = 0.55, Parent = knob }), "Color", "Accent")

		local api, value = {}, nil
		function api:Set(v, silent)
			v = tonumber(v) or value or min
			v = math.clamp(min + math.floor((v - min) / step + 0.5) * step, math.min(min, max), math.max(min, max))
			v = tonumber(fmt(v))
			local a = (max > min) and (v - min) / (max - min) or 0
			fill.Size = UDim2.fromScale(a, 1)
			knob.Position = UDim2.fromScale(a, 0.5)
			box.Text = fmt(v)
			if v == value then return end
			value = v
			if o.Callback and not silent then task.spawn(o.Callback, v) end
		end
		function api:Get() return value end
		api._fire = function() if o.Callback then task.spawn(o.Callback, value) end end

		local dragging = false
		local function update(x)
			local w = bar.AbsoluteSize.X
			if w <= 0 then return end
			api:Set(min + (max - min) * math.clamp((x - bar.AbsolutePosition.X) / w, 0, 1))
		end
		hitbox.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				update(i.Position.X)
				tween(knob, 0.15, { Size = UDim2.fromOffset(20, 20) })
			end
		end)
		lib:_conn(UserInputService.InputChanged:Connect(function(i)
			if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
				update(i.Position.X)
			end
		end))
		lib:_conn(UserInputService.InputEnded:Connect(function(i)
			if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
				dragging = false
				tween(knob, 0.15, { Size = UDim2.fromOffset(16, 16) })
			end
		end))
		box.FocusLost:Connect(function() api:Set(box.Text) end)
		api:Set(tonumber(o.Default) or min, true)
		lib:_regCfg(o.Key, api)
		return api
	end

	function sec:AddButton(o)
		local r, hit = row(90, o.Name, o.Description, true)
		local label = o.ButtonText or "▶  Run"
		local btn = lib:_bind(new("TextButton", {
			Text = label, Font = FONT_B, TextSize = 12, TextColor3 = WHITE, AutoButtonColor = false, Active = false,
			Size = UDim2.fromOffset(78, 28), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), ZIndex = 2, Parent = r,
		}, { corner(8) }), "BackgroundColor3", "Accent")
		gloss(btn, 1.5)
		local bStroke = new("UIStroke", { Color = WHITE, Transparency = 0.72, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = btn })
		local bScale = new("UIScale", { Scale = 1, Parent = btn })
		hit.MouseEnter:Connect(function()
			tween(btn, 0.18, { BackgroundTransparency = 0.08 })
			tween(bStroke, 0.18, { Transparency = 0.35 })
			tween(bScale, 0.18, { Scale = 1.05 })
		end)
		hit.MouseLeave:Connect(function()
			tween(btn, 0.18, { BackgroundTransparency = 0 })
			tween(bStroke, 0.18, { Transparency = 0.72 })
			tween(bScale, 0.18, { Scale = 1 })
		end)
		local api = {}
		function api:Fire() if o.Callback then task.spawn(o.Callback) end end
		function api:SetText(t) btn.Text = tostring(t) end
		hit.MouseButton1Click:Connect(function()
			bScale.Scale = 0.92
			tween(bScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
			api:Fire()
		end)
