function Library:_section(tab, parent, name)
	local lib = self
	local sec = {}
	self._secSeq = (self._secSeq or 0) + 1

	local frame = self:_bind(new("Frame", {
		Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 0.1, ClipsDescendants = true,
		LayoutOrder = self._secSeq, Parent = parent,
	}, { corner(12) }), "BackgroundColor3", "Panel")
	self:_bind(new("UIStroke", { Transparency = 0.35, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = frame }), "Color", "Stroke")
